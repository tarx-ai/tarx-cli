#!/bin/sh
# TARX CLI — local AI engine control plane
# Usage: tarx <command> [options]

set -e

TARX_VERSION="1.1.0"

# ── Platform paths ───────────────────────────────────────────────────

_os="$(uname -s)"
case "$_os" in
  Darwin) TARX_DATA="${HOME}/Library/Application Support/tarx" ;;
  *)      TARX_DATA="${HOME}/.tarx" ;;
esac

TARX_HOME="${TARX_HOME:-${HOME}/.tarx}"
TARX_MODELS="${TARX_DATA}/models"
TARX_HOME_MODELS="${TARX_HOME}/models"
TARX_LOGS="${TARX_DATA}/logs"
TARX_PID_DIR="${TARX_DATA}/pids"
INFERENCE_PORT=11435
MESH_PORT=11436
EMBED_PORT=11437
COGNITIVE_PORT=11438

# Supercomputer door (display/health only — set by their own launchd jobs,
# NOT bound by this CLI). Gateway is the public door via https://compute.tarx.com.
SUPERCOMPUTER_GATEWAY_PORT=11450
SUPERCOMPUTER_MODEL_PORT=11445
BRIDGE_PORT=11440

INFERENCE_MODEL="gemma-4-26B-A4B-it-Q4_K_M.gguf"
INFERENCE_MODEL_FALLBACK="NVIDIA-Nemotron3-Nano-4B-Q4_K_M.gguf"
EMBED_MODEL="nomic-embed-text-v1.5.Q4_K_M.gguf"

# ── Helpers ──────────────────────────────────────────────────────────

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

ensure_dirs() {
  mkdir -p "$TARX_LOGS" "$TARX_PID_DIR" 2>/dev/null || true
}

check_port() {
  curl -sf "http://127.0.0.1:${1}/health" >/dev/null 2>&1
}

pid_file() {
  echo "${TARX_PID_DIR}/${1}.pid"
}

is_running() {
  _pf="$(pid_file "$1")"
  if [ -f "$_pf" ]; then
    _pid=$(cat "$_pf")
    if kill -0 "$_pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$_pf"
  fi
  return 1
}

find_llama_server() {
  # Check common locations
  for _path in \
    /opt/homebrew/bin/llama-server \
    /usr/local/bin/llama-server \
    "${HOME}/.local/bin/llama-server" \
    "$(command -v llama-server 2>/dev/null || true)"; do
    if [ -n "$_path" ] && [ -x "$_path" ]; then
      echo "$_path"
      return 0
    fi
  done
  return 1
}

find_mesh_binary() {
  for _path in \
    "${HOME}/Desktop/tarx-mesh/target/release/tarx-mesh" \
    /usr/local/bin/tarx-mesh \
    "$(command -v tarx-mesh 2>/dev/null || true)"; do
    if [ -n "$_path" ] && [ -x "$_path" ]; then
      echo "$_path"
      return 0
    fi
  done
  return 1
}

find_model_file() {
  for _candidate in "$@"; do
    [ -n "$_candidate" ] || continue
    case "$_candidate" in
      /*)
        if [ -f "$_candidate" ]; then
          echo "$_candidate"
          return 0
        fi
        ;;
      *)
        for _dir in "$TARX_MODELS" "$TARX_HOME_MODELS"; do
          if [ -f "${_dir}/${_candidate}" ]; then
            echo "${_dir}/${_candidate}"
            return 0
          fi
        done
        ;;
    esac
  done
  return 1
}

# ── start ────────────────────────────────────────────────────────────

cmd_start() {
  ensure_dirs
  log "Starting TARX services..."

  _started=0

  # 1. Inference server (port 11435)
  if check_port $INFERENCE_PORT; then
    log "  Inference  (${INFERENCE_PORT}): already running"
  else
    _llama="$(find_llama_server)" || true
    _model_path="$(find_model_file "${TARX_INFERENCE_MODEL:-}" "$INFERENCE_MODEL" "$INFERENCE_MODEL_FALLBACK" || true)"

    if [ -z "$_llama" ]; then
      warn "llama-server not found — install with: brew install llama.cpp"
    elif [ -z "$_model_path" ]; then
      warn "Inference model not found in ${TARX_MODELS} or ${TARX_HOME_MODELS}"
      warn "Download with: tarx update --models"
    else
      "$_llama" \
        --host 127.0.0.1 \
        --port $INFERENCE_PORT \
        --model "$_model_path" \
        --ctx-size 8192 \
        --parallel 2 \
        --no-warmup \
        > "${TARX_LOGS}/inference.log" 2>&1 &
      echo $! > "$(pid_file inference)"
      log "  Inference  (${INFERENCE_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  # 2. Embedding server (port 11437)
  if check_port $EMBED_PORT; then
    log "  Embeddings (${EMBED_PORT}): already running"
  else
    _llama="$(find_llama_server)" || true
    _embed_path="$(find_model_file "${TARX_EMBED_MODEL:-}" "$EMBED_MODEL" || true)"

    if [ -z "$_llama" ]; then
      warn "llama-server not found — install with: brew install llama.cpp"
    elif [ -z "$_embed_path" ]; then
      warn "Embedding model not found in ${TARX_MODELS} or ${TARX_HOME_MODELS}"
      warn "Download with: tarx update --models"
    else
      "$_llama" \
        --host 127.0.0.1 \
        --port $EMBED_PORT \
        --model "$_embed_path" \
        --ctx-size 8192 \
        --embeddings \
        --pooling mean \
        --parallel 1 \
        --no-warmup \
        > "${TARX_LOGS}/embeddings.log" 2>&1 &
      echo $! > "$(pid_file embeddings)"
      log "  Embeddings (${EMBED_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  # 3. Mesh server (port 11436)
  if check_port $MESH_PORT; then
    log "  Mesh       (${MESH_PORT}): already running"
  else
    _mesh="$(find_mesh_binary)" || true
    if [ -z "$_mesh" ]; then
      log "  Mesh       (${MESH_PORT}): binary not found (optional)"
    else
      TARX_MESH_BIND="127.0.0.1:${MESH_PORT}" "$_mesh" \
        > "${TARX_LOGS}/mesh.log" 2>&1 &
      echo $! > "$(pid_file mesh)"
      log "  Mesh       (${MESH_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  if [ $_started -gt 0 ]; then
    log ""
    log "Waiting for services..."
    sleep 3
    cmd_status
  else
    log ""
    log "All services already running."
  fi
}

# ── stop ─────────────────────────────────────────────────────────────

cmd_stop() {
  log "Stopping TARX services..."

  for _svc in inference embeddings mesh; do
    _pf="$(pid_file "$_svc")"
    if [ -f "$_pf" ]; then
      _pid=$(cat "$_pf")
      if kill -0 "$_pid" 2>/dev/null; then
        kill "$_pid" 2>/dev/null || true
        log "  Stopped ${_svc} (pid ${_pid})"
      fi
      rm -f "$_pf"
    else
      # Try to find by port
      case "$_svc" in
        inference)  _port=$INFERENCE_PORT ;;
        embeddings) _port=$EMBED_PORT ;;
        mesh)       _port=$MESH_PORT ;;
      esac
      _pid=$(lsof -ti ":${_port}" 2>/dev/null | head -1) || true
      if [ -n "$_pid" ]; then
        kill "$_pid" 2>/dev/null || true
        log "  Stopped ${_svc} (pid ${_pid})"
      else
        log "  ${_svc}: not running"
      fi
    fi
  done

  log "Done."
}

# ── status ───────────────────────────────────────────────────────────

cmd_status() {
  log "TARX Service Status"
  log "═══════════════════"
  log ""
  printf '  %-14s %-8s %s\n' "SERVICE" "PORT" "STATUS"
  printf '  %-14s %-8s %s\n' "──────────" "─────" "──────"

  for _svc_info in "Inference(local):${INFERENCE_PORT}" "Mesh(local):${MESH_PORT}" "Embeddings(local):${EMBED_PORT}" "Cognitive(local):${COGNITIVE_PORT}" "Bridge(local):${BRIDGE_PORT}" "Supercomputer:${SUPERCOMPUTER_GATEWAY_PORT}" "SC-model:${SUPERCOMPUTER_MODEL_PORT}"; do
    _name="${_svc_info%%:*}"
    _port="${_svc_info##*:}"

    if check_port "$_port"; then
      _status="running"
    elif is_running "$(echo "$_name" | tr '[:upper:]' '[:lower:]')"; then
      _status="starting"
    else
      _status="stopped"
    fi

    printf '  %-14s %-8s %s\n' "$_name" "$_port" "$_status"
  done

  log ""
}

# ── chat ─────────────────────────────────────────────────────────────

cmd_chat() {
  # Door for interactive/engaged chat = Supercomputer gateway (tarx/t-supercomputer).
  # One-shot (with args) keeps local Mind for speed; interactive uses the door.
  _gw="http://127.0.0.1:${SUPERCOMPUTER_GATEWAY_PORT}"

  # Pull the gateway bearer from the running gateway process env. Never printed.
  _chat_key() {
    _p=$(lsof -ti tcp:${SUPERCOMPUTER_GATEWAY_PORT} -sTCP:LISTEN 2>/dev/null | head -1)
    [ -n "$_p" ] && ps eww -o command= -p "$_p" 2>/dev/null | tr ' ' '\n' | grep '^TARX_GATEWAY_API_KEY=' | cut -d= -f2-
  }

  # One request to the door. $1 = JSON messages array. Prints assistant text.
  _chat_once() {
    _msgs="$1"; _key="$2"
    # Stream SSE live. Show a "thinking" indicator immediately (first token can be
    # 30–60s on the cold/slow 27B) and clear it the moment real tokens arrive, so a
    # slow first token never looks like a hang. Returns full text for history.
    _pl=$(MSGS="$_msgs" python3 -c "import os,json;print(json.dumps({'model':'tarx/t-supercomputer','messages':json.loads(os.environ['MSGS']),'stream':True,'max_tokens':1024}))" 2>/dev/null)

    # background spinner on the tty until a signal file appears
    _spin="/tmp/.tarx_spin_$$"; : > "$_spin"
    (
      i=0
      while [ -f "$_spin" ]; do
        case $((i % 4)) in 0) c='·  ';; 1) c='·· ';; 2) c='···';; 3) c=' ··';; esac
        printf '\r\033[2m(thinking %s t=%ss)\033[0m' "$c" "$i" > /dev/tty 2>/dev/null
        i=$((i+1)); sleep 1
      done
    ) &
    _spinpid=$!

    curl -sf -N -m 300 -X POST "${_gw}/v1/chat/completions" \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer ${_key}" \
      -d "$_pl" 2>/dev/null | SPIN="$_spin" python3 -c "
import sys,json,os
full=[]; first=True
try: tty=open('/dev/tty','w')
except Exception: tty=None
for line in sys.stdin:
    line=line.strip()
    if not line.startswith('data:'): continue
    p=line[5:].strip()
    if p=='[DONE]': break
    try:
        d=json.loads(p); delta=d.get('choices',[{}])[0].get('delta',{}).get('content')
        if delta:
            if first:
                # stop spinner + clear its line before first token
                try: os.remove(os.environ['SPIN'])
                except Exception: pass
                if tty: tty.write('\r\033[K'); tty.flush()
                first=False
            if tty: tty.write(delta); tty.flush()
            full.append(delta)
    except Exception: pass
if tty: tty.write('\n\n'); tty.flush()
sys.stdout.write(''.join(full))
" 2>/dev/null
    rm -f "$_spin" 2>/dev/null; kill "$_spinpid" 2>/dev/null; wait "$_spinpid" 2>/dev/null
  }

  _esc() { printf '%s' "$1" | python3 -c "import sys,json;print(json.dumps(sys.stdin.read()))" 2>/dev/null; }

  # ── Interactive session (no args): a place to type and engage TARX ──
  if [ -z "$1" ]; then
    if ! check_port "$SUPERCOMPUTER_GATEWAY_PORT"; then
      err "Supercomputer door not running on :${SUPERCOMPUTER_GATEWAY_PORT}."
    fi
    _key=$(_chat_key)
    [ -z "$_key" ] && err "Supercomputer door needs its key (TARX_GATEWAY_API_KEY) to engage."
    if [ -t 1 ]; then _dim='\033[2m'; _rst='\033[0m'; else _dim=''; _rst=''; fi
    printf '%b────────────────────────────────────────────────────────%b\n' "$_dim" "$_rst"
    printf '%bTARX · Supercomputer · talk below · "exit" to leave%b\n\n' "$_dim" "$_rst"
    _spf="$HOME/.tarx/always-on/session-prompt.md"
    _histfile="$HOME/.tarx/always-on/session-history.json"
    _livectx=$("$HOME/.tarx/bin/tarx-live-context.sh" 2>/dev/null)

    # Build system message = static moment + LIVE state (current reality).
    _sysmsg=$(SPF="$_spf" LCTX="$_livectx" python3 -c "
import json,os
base=''
try: base=open(os.environ['SPF']).read()
except Exception: base='You are TARX.'
print(json.dumps(base + '\n\n' + os.environ.get('LCTX','')))
" 2>/dev/null)

    # Resume recent conversation across launches (last ~12 turns), else fresh.
    _hist=$(SYS="$_sysmsg" HF="$_histfile" python3 -c "
import json,os
sys_content=json.loads(os.environ['SYS'])
h=[{'role':'system','content':sys_content}]
hf=os.environ['HF']
try:
    prior=json.load(open(hf))
    prior=[m for m in prior if m.get('role') in ('user','assistant')][-12:]
    h+=prior
except Exception: pass
print(json.dumps(h))
" 2>/dev/null)
    [ -z "${_hist:-}" ] && _hist="[]"

    while :; do
      printf 'you › '
      if ! IFS= read -r _line; then printf '\n'; break; fi
      case "$_line" in exit|quit|:q) break ;; "") continue ;; esac
      _ujson=$(_esc "$_line")
      _hist=$(printf '%s' "$_hist" | python3 -c "import sys,json;h=json.load(sys.stdin);h.append({'role':'user','content':$_ujson});print(json.dumps(h))" 2>/dev/null)
      printf 'tarx › '
      _ans=$(_chat_once "$_hist" "$_key")
      if [ -z "$_ans" ]; then printf '(no response — door may be cold; try again)\n\n'; continue; fi
      _ajson=$(_esc "$_ans")
      _hist=$(printf '%s' "$_hist" | python3 -c "import sys,json;h=json.load(sys.stdin);h.append({'role':'assistant','content':$_ajson});print(json.dumps(h))" 2>/dev/null)
      # Persist conversation (user/assistant only) so the next launch resumes.
      printf '%s' "$_hist" | python3 -c "
import sys,json
h=json.load(sys.stdin)
keep=[m for m in h if m.get('role') in ('user','assistant')][-40:]
json.dump(keep, open('$_histfile','w'))
" 2>/dev/null
    done
    return 0
  fi

  # ── One-shot (with args): fast local Mind ──
  if ! check_port $INFERENCE_PORT; then
    err "Inference server not running on port ${INFERENCE_PORT}. Run: tarx start"
  fi

  _prompt="$*"
  # Escape for JSON
  _escaped=$(printf '%s' "$_prompt" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g')

  _payload="{\"model\":\"local\",\"messages\":[{\"role\":\"user\",\"content\":\"${_escaped}\"}],\"stream\":false,\"max_tokens\":2048}"

  _response=$(curl -sf -X POST "http://127.0.0.1:${INFERENCE_PORT}/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -d "$_payload" 2>/dev/null) || err "Request failed. Is the inference server running?"

  _content=""
  if command -v python3 >/dev/null 2>&1; then
    _content=$(printf '%s' "$_response" | python3 -c "
import sys, json
r = json.load(sys.stdin)
message = r.get('choices', [{}])[0].get('message', {})
print(message.get('content') or message.get('reasoning_content') or '')
" 2>/dev/null) || true
  fi

  if [ -z "$_content" ]; then
    _content=$(printf '%s' "$_response" | sed -n 's/.*"content"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
  fi

  if [ -z "$_content" ]; then
    log "$_response"
  else
    printf '%s\n' "$_content"
  fi
}

# ── embed ────────────────────────────────────────────────────────────

cmd_embed() {
  if [ -z "$1" ]; then
    err "Usage: tarx embed <file>"
  fi

  _file="$1"
  if [ ! -f "$_file" ]; then
    err "File not found: $_file"
  fi

  if ! check_port $EMBED_PORT; then
    err "Embedding server not running on port ${EMBED_PORT}. Run: tarx start"
  fi

  _size=$(wc -c < "$_file" | tr -d ' ')
  log "Embedding ${_file} (${_size} bytes)..."

  # Read and chunk (512 char chunks, 128 overlap)
  _content=$(cat "$_file")
  _len=${#_content}
  _chunk_size=512
  _overlap=128
  _offset=0
  _chunks=0

  while [ $_offset -lt "$_len" ]; do
    _chunk=$(printf '%s' "$_content" | cut -c$((_offset + 1))-$((_offset + _chunk_size)))
    _escaped=$(printf '%s' "$_chunk" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g' | tr '\n' ' ')

    curl -sf -X POST "http://127.0.0.1:${EMBED_PORT}/embedding" \
      -H "Content-Type: application/json" \
      -d "{\"content\":\"${_escaped}\"}" >/dev/null 2>&1 || warn "Failed to embed chunk at offset $_offset"

    _chunks=$((_chunks + 1))
    _offset=$((_offset + _chunk_size - _overlap))
  done

  log "Done: ${_chunks} chunks embedded."
}

# ── search ───────────────────────────────────────────────────────────

cmd_search() {
  if [ -z "$1" ]; then
    err "Usage: tarx search \"query\""
  fi

  if ! check_port $EMBED_PORT; then
    err "Embedding server not running on port ${EMBED_PORT}. Run: tarx start"
  fi

  _query="$*"
  _escaped=$(printf '%s' "$_query" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g')

  log "Searching: ${_query}"
  log ""

  _result=$(curl -sf -X POST "http://127.0.0.1:${EMBED_PORT}/v1/embeddings" \
    -H "Content-Type: application/json" \
    -d "{\"input\":\"${_escaped}\",\"model\":\"local\"}" 2>/dev/null) || err "Search failed. Is the embedding server running?"

  log "$_result"
}

# ── mesh ─────────────────────────────────────────────────────────────

cmd_mesh() {
  _subcmd="${1:-status}"
  shift 2>/dev/null || true

  case "$_subcmd" in
    status)
      if ! check_port $MESH_PORT; then
        err "Mesh server not running on port ${MESH_PORT}. Run: tarx start"
      fi
      _resp=$(curl -sf "http://127.0.0.1:${MESH_PORT}/api/v1/status" 2>/dev/null) || err "Mesh status request failed"
      log "$_resp"
      ;;
    join)
      if ! check_port $MESH_PORT; then
        err "Mesh server not running on port ${MESH_PORT}. Run: tarx start"
      fi
      _resp=$(curl -sf -X POST "http://127.0.0.1:${MESH_PORT}/api/v1/mesh/join" 2>/dev/null) || err "Mesh join failed"
      log "Joined mesh network."
      log "$_resp"
      ;;
    *)
      err "Unknown mesh command: $_subcmd (available: status, join)"
      ;;
  esac
}

# ── spaces ───────────────────────────────────────────────────────────

cmd_spaces() {
  _subcmd="${1:-list}"
  shift 2>/dev/null || true

  _spaces_dir="${TARX_DATA}/spaces"
  mkdir -p "$_spaces_dir" 2>/dev/null || true

  case "$_subcmd" in
    list)
      log "Project Spaces"
      log "══════════════"
      if [ -d "$_spaces_dir" ]; then
        _count=0
        for _space in "${_spaces_dir}"/*; do
          if [ -d "$_space" ]; then
            _name=$(basename "$_space")
            _files=$(find "$_space" -type f 2>/dev/null | wc -l | tr -d ' ')
            printf '  %s (%s files)\n' "$_name" "$_files"
            _count=$((_count + 1))
          fi
        done
        if [ $_count -eq 0 ]; then
          log "  No spaces yet. Create one: tarx spaces create \"my-project\""
        fi
      fi
      ;;
    create)
      if [ -z "$1" ]; then
        err "Usage: tarx spaces create \"name\""
      fi
      _name="$1"
      _path="${_spaces_dir}/${_name}"
      if [ -d "$_path" ]; then
        err "Space '${_name}' already exists."
      fi
      mkdir -p "$_path"
      log "Created space: ${_name}"
      log "Path: ${_path}"
      ;;
    *)
      err "Unknown spaces command: $_subcmd (available: list, create)"
      ;;
  esac
}

# ── update ───────────────────────────────────────────────────────────

cmd_update() {
  log "  Checking for updates..."
  log ""

  _api_url="https://tarx.com/api/cli/latest"
  _release_json="$(curl -fsSL "$_api_url" 2>/dev/null)" || true
  if [ -z "$_release_json" ]; then
    err "Could not reach update server. Check network."
  fi

  _latest="$(echo "$_release_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['version'])" 2>/dev/null || echo "")"
  if [ -z "$_latest" ]; then
    err "Could not parse release info."
  fi

  if [ "$TARX_VERSION" = "$_latest" ] && [ "${1:-}" != "--force" ]; then
    log "  Already on latest version: v${TARX_VERSION}"
    # Check for --models flag
    if [ "${1:-}" = "--models" ]; then
      log ""
      download_models
    fi
    return
  fi

  log "  Update available: v${TARX_VERSION} -> v${_latest}"
  log ""

  # Detect platform
  _os="$(uname -s)"
  _arch="$(uname -m)"
  case "$_os" in
    Darwin) _platform="darwin" ;;
    Linux)  _platform="linux" ;;
    *)      err "Unsupported OS: $_os" ;;
  esac
  case "$_arch" in
    arm64|aarch64) _arch_key="arm64" ;;
    x86_64)        _arch_key="x64" ;;
    *)             err "Unsupported architecture: $_arch" ;;
  esac
  _target="${_platform}-${_arch_key}"

  _tarx_home="${TARX_HOME:-$HOME/.tarx}"
  _tarx_bin="${_tarx_home}/bin"

  # 1. Update daemon binary
  _daemon_url="$(echo "$_release_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['${_target}']['url'])" 2>/dev/null || echo "")"
  if [ -n "$_daemon_url" ]; then
    log "  Updating tarxd..."
    curl -fsSL "$_daemon_url" -o "${_tarx_bin}/tarxd.new" && \
      chmod +x "${_tarx_bin}/tarxd.new" && \
      mv "${_tarx_bin}/tarxd.new" "${_tarx_bin}/tarxd" && \
      log "    ✓ tarxd updated" || log "    ⚠ tarxd update failed (keeping current)"
  fi

  # 2. Update CLI
  _cli_url="https://raw.githubusercontent.com/tarx-ai/tarx-cli/main/tarx"
  log "  Updating CLI..."
  curl -fsSL "$_cli_url" -o "${_tarx_bin}/tarx.new" 2>/dev/null && \
    chmod +x "${_tarx_bin}/tarx.new" && \
    mv "${_tarx_bin}/tarx.new" "${_tarx_bin}/tarx" && \
    log "    ✓ CLI updated" || log "    ⚠ CLI update failed (keeping current)"

  # 3. Update MCP server bundles
  log "  Updating MCP servers..."
  for _srv in tarx-core tarx-ops; do
    _srv_url="$(echo "$_release_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('servers',{}).get('$_srv',{}).get('url',''))" 2>/dev/null || echo "")"
    if [ -n "$_srv_url" ]; then
      mkdir -p "${_tarx_home}/servers/${_srv}"
      curl -fsSL "$_srv_url" | tar xz -C "${_tarx_home}/servers/${_srv}" 2>/dev/null && \
        log "    ✓ $_srv" || log "    ⚠ $_srv update failed (keeping current)"
    fi
  done

  # 4. Rebuild native modules if needed
  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    for _srv in tarx-core tarx-ops; do
      if [ -d "${_tarx_home}/servers/${_srv}/node_modules/better-sqlite3" ]; then
        (cd "${_tarx_home}/servers/${_srv}" && npm rebuild better-sqlite3 2>/dev/null) && \
          log "    ✓ $_srv native modules" || true
      fi
    done
  fi

  # 5. Restart daemon if running
  if [ "$_os" = "Darwin" ]; then
    _plist="$HOME/Library/LaunchAgents/com.tarx.daemon.plist"
    if [ -f "$_plist" ]; then
      log "  Restarting daemon..."
      launchctl kickstart -k "gui/$(id -u)/com.tarx.daemon" 2>/dev/null && \
        log "    ✓ daemon restarted" || log "    ⚠ restart failed (run: launchctl kickstart -k gui/$(id -u)/com.tarx.daemon)"
    fi
  elif [ "$_os" = "Linux" ]; then
    if systemctl --user is-active tarx >/dev/null 2>&1; then
      log "  Restarting daemon..."
      systemctl --user restart tarx && \
        log "    ✓ daemon restarted" || true
    fi
  fi

  log ""
  log "  ✓ Updated to v${_latest}"
  log ""

  # Check for --models flag
  if [ "${1:-}" = "--models" ]; then
    download_models
  fi
}

download_models() {
  log "Checking models..."
  mkdir -p "$TARX_MODELS" 2>/dev/null || true

  _inference_path="$(find_model_file "${TARX_INFERENCE_MODEL:-}" "$INFERENCE_MODEL" "$INFERENCE_MODEL_FALLBACK" || true)"
  _embed_path="$(find_model_file "${TARX_EMBED_MODEL:-}" "$EMBED_MODEL" || true)"

  if [ -n "$_inference_path" ]; then
    _size=$(wc -c < "$_inference_path" | tr -d ' ')
    log "  Inference model: present ($((_size / 1048576)) MB)"
  else
    log "  Inference model: missing"
    log "  Download ~4.4 GB from: https://tarx.com/models/${INFERENCE_MODEL}"
  fi

  if [ -n "$_embed_path" ]; then
    _size=$(wc -c < "$_embed_path" | tr -d ' ')
    log "  Embedding model: present ($((_size / 1048576)) MB)"
  else
    log "  Embedding model: missing"
    log "  Download ~95 MB from: https://tarx.com/models/${EMBED_MODEL}"
  fi
}

# ── uninstall ────────────────────────────────────────────────────────

cmd_uninstall() {
  log "TARX Uninstaller"
  log ""

  # Stop services first
  cmd_stop 2>/dev/null || true

  # Remove binary
  _bin_path="$(command -v tarx 2>/dev/null || true)"
  if [ -n "$_bin_path" ]; then
    log "Remove binary: ${_bin_path}"
    if [ -w "$(dirname "$_bin_path")" ]; then
      rm -f "$_bin_path"
    else
      sudo rm -f "$_bin_path"
    fi
    log "  Removed."
  fi

  # Ask about data
  log ""
  log "Data directory: ${TARX_DATA}"
  if [ -d "$TARX_DATA" ]; then
    _size=$(du -sh "$TARX_DATA" 2>/dev/null | awk '{print $1}')
    log "Size: ${_size}"
    log ""
    printf 'Delete all TARX data including models? [y/N] '
    read -r _confirm
    case "$_confirm" in
      [yY]|[yY][eE][sS])
        rm -rf "$TARX_DATA"
        log "Data deleted."
        ;;
      *)
        log "Data preserved at ${TARX_DATA}"
        ;;
    esac
  fi

  log ""
  log "TARX uninstalled."
}

# ── doctor ───────────────────────────────────────────────────────────

cmd_doctor() {
  log "TARX Doctor"
  log "═══════════"
  log ""

  _issues=0

  # Check ports
  log "Services:"
  for _svc_info in "Inference(local):${INFERENCE_PORT}" "Mesh(local):${MESH_PORT}" "Embeddings(local):${EMBED_PORT}" "Cognitive(local):${COGNITIVE_PORT}" "Bridge(local):${BRIDGE_PORT}" "Supercomputer:${SUPERCOMPUTER_GATEWAY_PORT}" "SC-model:${SUPERCOMPUTER_MODEL_PORT}"; do
    _name="${_svc_info%%:*}"
    _port="${_svc_info##*:}"
    if check_port "$_port"; then
      printf '  [OK] %-14s port %s\n' "$_name" "$_port"
    else
      # Check if port is taken by something else
      _occupant=$(lsof -ti ":${_port}" 2>/dev/null | head -1) || true
      if [ -n "$_occupant" ]; then
        _proc=$(ps -p "$_occupant" -o comm= 2>/dev/null) || _proc="unknown"
        printf '  [!!] %-14s port %s occupied by %s (pid %s)\n' "$_name" "$_port" "$_proc" "$_occupant"
        _issues=$((_issues + 1))
      else
        printf '  [--] %-14s port %s not running\n' "$_name" "$_port"
      fi
    fi
  done

  # ── Disk space gate (P0-CLI-DISK-GATE-001) ──
  # HARD FAIL below DISK_MIN_GB free. The old <6 GB warning was a false green:
  # multi-agent + Bridge WAL growth froze the machine at ~7 GB free. Memory plane
  # health = product health, so we enforce a 40 GB operating floor.
  log ""
  log "Disk:"
  DISK_MIN_GB="${TARX_DISK_MIN_GB:-40}"
  _avail=$(df -h "${HOME}" 2>/dev/null | awk 'NR==2{print $4}')
  # df -k = 1 KiB blocks (portable, unambiguous). Column 4 = available.
  _avail_kb=$(df -k "${HOME}" 2>/dev/null | awk 'NR==2{print $4}')
  _avail_gb=0
  if [ -n "$_avail_kb" ]; then _avail_gb=$(( _avail_kb / 1048576 )); fi
  log "  Available: ${_avail} (${_avail_gb} GB)"
  _min_kb=$(( DISK_MIN_GB * 1048576 ))
  if [ -n "$_avail_kb" ] && [ "$_avail_kb" -lt "$_min_kb" ] 2>/dev/null; then
    log "  [FAIL] Less than ${DISK_MIN_GB} GB free — refuse heavy work (crash risk)."
    _issues=$((_issues + 1))
  else
    log "  [OK] Sufficient space (floor ${DISK_MIN_GB} GB)"
  fi

  # ── Bridge WAL gate (P0-CLI-DISK-GATE-001) ──
  # ~/.tarx/tarx.db-wal ballooned 56->61 GB on 2026-10-04 (checkpointed frames
  # never truncated) and froze the machine. FAIL above WAL_MAX_GB; always report
  # WAL bytes when the file exists so operators can watch it before it melts.
  log ""
  log "Bridge WAL:"
  WAL_MAX_GB="${TARX_WAL_MAX_GB:-1}"
  _wal_file="${TARX_HOME}/tarx.db-wal"
  _wal_failed=0
  if [ -f "$_wal_file" ]; then
    _wal_bytes=$(wc -c < "$_wal_file" 2>/dev/null | tr -d ' ')
    [ -n "$_wal_bytes" ] || _wal_bytes=0
    _wal_mb=$(( _wal_bytes / 1048576 ))
    _wal_max_bytes=$(( WAL_MAX_GB * 1073741824 ))
    log "  File: ${_wal_file}"
    log "  Size: ${_wal_bytes} bytes (${_wal_mb} MB)"
    if [ "$_wal_bytes" -gt "$_wal_max_bytes" ] 2>/dev/null; then
      log "  [FAIL] WAL exceeds ${WAL_MAX_GB} GB — checkpoint/TRUNCATE before more work."
      log "         Writers must not leave wal_autocheckpoint=0; see Bridge follow-up below."
      _issues=$((_issues + 1))
      _wal_failed=1
    else
      log "  [OK] WAL under ${WAL_MAX_GB} GB"
    fi
  else
    log "  [--] No WAL file at ${_wal_file} (Bridge idle or checkpointed)"
  fi

  # Check models
  log ""
  log "Models:"
  _inference_path="$(find_model_file "${TARX_INFERENCE_MODEL:-}" "$INFERENCE_MODEL" "$INFERENCE_MODEL_FALLBACK" || true)"
  if [ -n "$_inference_path" ]; then
    _sz=$(wc -c < "$_inference_path" | tr -d ' ')
    printf '  [OK] Inference: %s (%s MB)\n' "$(basename "$_inference_path")" "$((_sz / 1048576))"
  else
    printf '  [!!] Inference model missing in %s or %s\n' "$TARX_MODELS" "$TARX_HOME_MODELS"
    _issues=$((_issues + 1))
  fi

  _embed_path="$(find_model_file "${TARX_EMBED_MODEL:-}" "$EMBED_MODEL" || true)"
  if [ -n "$_embed_path" ]; then
    _sz=$(wc -c < "$_embed_path" | tr -d ' ')
    printf '  [OK] Embedding: %s (%s MB)\n' "$(basename "$_embed_path")" "$((_sz / 1048576))"
  else
    printf '  [!!] Embedding model missing in %s or %s\n' "$TARX_MODELS" "$TARX_HOME_MODELS"
    _issues=$((_issues + 1))
  fi

  # Check RAM
  log ""
  log "System:"
  if [ "$_os" = "Darwin" ]; then
    _ram_bytes=$(sysctl -n hw.memsize 2>/dev/null) || _ram_bytes=0
    _ram_gb=$((_ram_bytes / 1073741824))
  else
    _ram_kb=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}') || _ram_kb=0
    _ram_gb=$((_ram_kb / 1048576))
  fi

  if [ "$_ram_gb" -ge 8 ]; then
    printf '  [OK] RAM: %s GB\n' "$_ram_gb"
  else
    printf '  [!!] RAM: %s GB (need 8 GB+)\n' "$_ram_gb"
    _issues=$((_issues + 1))
  fi

  # GPU detection
  if [ "$_os" = "Darwin" ]; then
    _gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | grep "Chipset Model" | sed 's/.*: //' | head -1) || true
    if [ -z "$_gpu" ]; then
      _gpu=$(sysctl -n machdep.cpu.brand_string 2>/dev/null | head -1) || _gpu="unknown"
    fi
    printf '  [OK] GPU: %s (Metal)\n' "$_gpu"
  else
    if command -v nvidia-smi >/dev/null 2>&1; then
      _gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1) || _gpu="NVIDIA (detected)"
      printf '  [OK] GPU: %s (CUDA)\n' "$_gpu"
    else
      log "  [--] GPU: no NVIDIA GPU detected (CPU inference only)"
    fi
  fi

  # llama-server binary
  _llama="$(find_llama_server)" || true
  if [ -n "$_llama" ]; then
    printf '  [OK] llama-server: %s\n' "$_llama"
  else
    log "  [!!] llama-server not found — install with: brew install llama.cpp"
    _issues=$((_issues + 1))
  fi

  log ""
  if [ $_issues -eq 0 ]; then
    log "All checks passed."
  else
    log "${_issues} issue(s) found."
  fi

  # ── Dual-CLI note (P0-CLI-DISK-GATE-001) ──
  # Operators routinely try `tarx build` on this PATH binary and hit
  # "Unknown command: build". Point them at the Node flywheel CLI.
  log ""
  log "Note — two TARX CLIs (do not confuse):"
  log "  • PATH shell CLI (this one), ~/.tarx/bin/tarx v${TARX_VERSION}:"
  log "      presence / status / doctor / start / stop / mcp. NO 'build'."
  log "  • Node flywheel CLI, tarx-cli/bin/tarx.mjs:"
  log "      planning + apply. Plan a task with:"
  log "      node bin/tarx.mjs build --plan-only --task \"...\""

  if [ "$_wal_failed" -ne 0 ]; then
    log ""
    log "Bridge follow-up: a red WAL gate means prod writers left"
    log "wal_autocheckpoint unhealthy (e.g. 0). Fix belongs in the Bridge DB"
    log "layer (single-writer + periodic PRAGMA wal_checkpoint(TRUNCATE)),"
    log "not this CLI — see MEMORY_SUPERINTELLIGENCE_ROADMAP_2026-10-04.md P0 #3."
  fi

  if [ $_issues -ne 0 ]; then
    return 1
  fi
  return 0
}

# ── version ──────────────────────────────────────────────────────────

cmd_version() {
  log "${TARX_VERSION}"
}

# ── tray ────────────────────────────────────────────────────────────

cmd_tray() {
  # Launch the standalone menu bar tray app
  _tray_dir=""
  # Check common locations for the tray app
  for _d in \
    "${HOME}/Desktop/tarx-code-oss/apps/tarx-tray" \
    "/Applications/TARX Workbench.app/Contents/Resources/apps/tarx-tray" \
    "${HOME}/.tarx/apps/tarx-tray"; do
    if [ -f "${_d}/main.js" ]; then
      _tray_dir="$_d"
      break
    fi
  done

  if [ -z "$_tray_dir" ]; then
    err "Tray app not found. Ensure tarx-code-oss is present at ~/Desktop/tarx-code-oss"
  fi

  # Find Electron binary
  _electron=""
  for _e in \
    "${_tray_dir}/../../.build/electron/TARX Workbench.app/Contents/MacOS/Electron" \
    "/Applications/TARX Workbench.app/Contents/MacOS/Electron"; do
    if [ -x "$_e" ]; then
      _electron="$_e"
      break
    fi
  done

  if [ -z "$_electron" ]; then
    err "Electron binary not found. Build tarx-code-oss or install TARX Workbench."
  fi

  log "Starting TARX tray..."
  exec "$_electron" "$_tray_dir"
}

# ── mcp ──────────────────────────────────────────────────────────────

# Detect config file path for each AI client
_mcp_config_path() {
  _client="$1"
  case "$_client" in
    claude)
      # Claude Desktop (macOS)
      if [ "$_os" = "Darwin" ]; then
        echo "$HOME/Library/Application Support/Claude/claude_desktop_config.json"
      else
        # Linux — Claude Desktop uses XDG or ~/.config
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/Claude/claude_desktop_config.json"
      fi
      ;;
    claude-code)
      echo "$HOME/.claude.json"
      ;;
    cursor)
      echo "$HOME/.cursor/mcp.json"
      ;;
    vscode)
      echo "$HOME/.vscode/mcp.json"
      ;;
  esac
}

# TARX MCP server definitions — NEVER include "type" field
_mcp_tarx_servers_json() {
  _tarx_home="${TARX_HOME:-$HOME/.tarx}"
  cat << SERVERSEOF
{
    "tarx": {
      "url": "https://mcp.tarx.com/mcp"
    },
    "tarx-core": {
      "command": "node",
      "args": ["${_tarx_home}/servers/tarx-core/dist/server.js"],
      "env": {
        "TARX_INFERENCE_URL": "http://localhost:11435",
        "TARX_EMBEDDING_URL": "http://localhost:11437",
        "TARX_MESH_URL": "http://localhost:11436"
      }
    },
    "tarx-ops": {
      "command": "node",
      "args": ["${_tarx_home}/servers/tarx-ops/dist/server.js"],
      "env": {
        "TARX_CREATOR_KEY": "tarx-creator-2025"
      }
    }
  }
SERVERSEOF
}

cmd_mcp() {
  _subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$_subcmd" in
    add)
      _target="${1:-}"
      if [ -z "$_target" ]; then
        err "Usage: tarx mcp add <target> (available: claude, claude-code, cursor, vscode)"
      fi

      _config_file=""
      _client_name=""
      case "$_target" in
        claude)
          _config_file="$(_mcp_config_path claude)"
          _client_name="Claude Desktop"
          ;;
        claude-code|cc)
          _config_file="$(_mcp_config_path claude-code)"
          _client_name="Claude Code"
          ;;
        cursor)
          _config_file="$(_mcp_config_path cursor)"
          _client_name="Cursor"
          ;;
        vscode|code)
          _config_file="$(_mcp_config_path vscode)"
          _client_name="VS Code"
          ;;
        *)
          err "Unknown target: $_target (available: claude, claude-code, cursor, vscode)"
          ;;
      esac

      if [ -z "$_config_file" ]; then
        err "Could not determine config path for $_target"
      fi

      # Check if already configured
      if [ -f "$_config_file" ] && grep -q '"tarx"' "$_config_file" 2>/dev/null; then
        # Validate no "type" fields leaked into existing config
        if grep -q '"type"' "$_config_file" 2>/dev/null; then
          log "  TARX found in $_config_file but has stale 'type' fields."
          log "  Cleaning..."
        else
          log "  TARX already configured in $_config_file"
          return
        fi
      fi

      # Require python3 for safe JSON merge
      if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 required for safe config merge"
        log ""
        log "  Add this manually to $_config_file:"
        log ""
        printf '  {\n    "mcpServers": %s\n  }\n' "$(_mcp_tarx_servers_json)"
        log ""
        log "  IMPORTANT: Do NOT include a \"type\" field on any server."
        return
      fi

      # Create parent dir
      mkdir -p "$(dirname "$_config_file")" 2>/dev/null || true

      # Backup existing config
      if [ -f "$_config_file" ]; then
        cp "$_config_file" "${_config_file}.bak" 2>/dev/null || true
      fi

      # Merge using python3 — NEVER writes "type" field
      python3 << PYEOF
import json, sys, os

config_path = "$_config_file"

# Read existing config or start fresh
config = {}
if os.path.exists(config_path):
    try:
        with open(config_path, 'r') as f:
            config = json.load(f)
    except (json.JSONDecodeError, ValueError):
        config = {}

if 'mcpServers' not in config:
    config['mcpServers'] = {}

# TARX servers — NEVER include "type" field
tarx_home = os.path.expanduser("~/.tarx")
tarx_servers = {
    "tarx": {
        "url": "https://mcp.tarx.com/mcp"
    },
    "tarx-core": {
        "command": "node",
        "args": [os.path.join(tarx_home, "servers/tarx-core/dist/server.js")],
        "env": {
            "TARX_INFERENCE_URL": "http://localhost:11435",
            "TARX_EMBEDDING_URL": "http://localhost:11437",
            "TARX_MESH_URL": "http://localhost:11436"
        }
    },
    "tarx-ops": {
        "command": "node",
        "args": [os.path.join(tarx_home, "servers/tarx-ops/dist/server.js")],
        "env": {
            "TARX_CREATOR_KEY": "tarx-creator-2025"
        }
    }
}

# Merge — add or replace TARX servers, preserve everything else
for name, server_config in tarx_servers.items():
    config['mcpServers'][name] = server_config

# Strip any "type" fields from ALL servers (including non-TARX ones)
for name, server in config['mcpServers'].items():
    if isinstance(server, dict) and 'type' in server:
        del server['type']

# Write
with open(config_path, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')

# Validate — re-read and check no "type" fields
with open(config_path, 'r') as f:
    validated = json.load(f)

has_type = False
for name, server in validated.get('mcpServers', {}).items():
    if isinstance(server, dict) and 'type' in server:
        has_type = True
        break

if has_type:
    # Restore backup
    bak = config_path + '.bak'
    if os.path.exists(bak):
        os.replace(bak, config_path)
    print("  ERROR: Validation failed — 'type' field detected. Config restored from backup.", file=sys.stderr)
    sys.exit(1)

# Clean up backup on success
bak = config_path + '.bak'
if os.path.exists(bak):
    os.remove(bak)

print("  ok")
PYEOF

      if [ $? -ne 0 ]; then
        err "Config write failed. Check $_config_file and retry."
      fi

      log ""
      log "  ✓ TARX added to $_client_name"
      log ""
      log "  → Restart $_client_name to activate TARX tools"
      log "  → Docs: howdy.tarx.com/quickstart"
      log ""
      ;;
    status)
      log "  MCP Configuration Status"
      log "  ════════════════════════"
      log ""
      for _c in claude claude-code cursor vscode; do
        _cf="$(_mcp_config_path "$_c")"
        case "$_c" in
          claude)      _cn="Claude Desktop" ;;
          claude-code) _cn="Claude Code" ;;
          cursor)      _cn="Cursor" ;;
          vscode)      _cn="VS Code" ;;
        esac
        if [ -f "$_cf" ] && grep -q '"tarx"' "$_cf" 2>/dev/null; then
          if grep -q '"type"' "$_cf" 2>/dev/null; then
            printf '  [!!] %-16s %s (has stale "type" fields — run: tarx mcp add %s)\n' "$_cn" "$_cf" "$_c"
          else
            printf '  [OK] %-16s %s\n' "$_cn" "$_cf"
          fi
        else
          printf '  [--] %-16s not configured\n' "$_cn"
        fi
      done
      log ""
      log "  Remote: https://mcp.tarx.com/mcp"
      log "  Fix:    tarx mcp add <target>"
      log ""
      ;;
    *)
      err "Unknown mcp command: $_subcmd (available: add, status)"
      ;;
  esac
}

# ── help ─────────────────────────────────────────────────────────────

# ── Always On · Presence (TARX_ALWAYS_ON_PRODUCT_LAW §5.1, §17) ───────
# Presence is the on-switch and vital signs. Not a chat. This renderer only
# reports truth from the Presence service. §16: no auto-speak, no second
# personality, no filling an empty state.

_presence_json() { "$HOME/.tarx/bin/tarx-presence.sh" get 2>/dev/null; }

_presence_field() { # $1 = python expression on dict d
  _presence_json | python3 -c "import sys,json;d=json.load(sys.stdin);print($1)" 2>/dev/null
}

cmd_presence() {
  _mode=$(_presence_field "d['mode']")
  _runtime=$(_presence_field "d['runtime']")
  _health=$(_presence_field "d['watchers']['runtime_health']")
  _consol=$(_presence_field "d['watchers']['memory_consolidation']")
  _last=$(_presence_field "d['last_reassessment']")
  [ -z "${_mode:-}" ] && _mode="asleep"
  [ -z "${_runtime:-}" ] && _runtime="unknown"

  # Color tokens (spec §3); plain if NO_COLOR/non-tty.
  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TARX_PLAIN:-}" != "1" ]; then
    _dm='\033[2m'; _live='\033[32m'; _wait='\033[33m'; _down='\033[31m'; _rs='\033[0m'
  else _dm=''; _live=''; _wait=''; _down=''; _rs=''; fi

  # Presence line (spec §5): keyed on runtime, not mode mislabel.
  case "$_runtime" in
    up)       _pline="TARX is on." ; _rcol="$_live" ;;
    starting) _pline="TARX is coming up." ; _rcol="$_wait" ;;
    down|offline) _pline="TARX is here when you want it." ; _rcol="$_down" ;;
    *)        _pline="TARX is here when you want it." ; _rcol="$_dm" ;;
  esac

  _wcol() { case "$1" in live) printf '%b' "$_live";; down) printf '%b' "$_down";; *) printf '%b' "$_dm";; esac; }

  # stale suffix if last reassessment > 15 min old (spec §5)
  _stale=""
  if [ -n "${_last:-}" ]; then
    _age=$(python3 -c "import time,calendar;import sys
try:
  t=calendar.timegm(time.strptime('$_last','%Y-%m-%dT%H:%M:%SZ'));print(int(time.time()-t))
except Exception: print(-1)" 2>/dev/null)
    [ "${_age:-0}" -gt 900 ] 2>/dev/null && _stale=" ${_dm}· stale${_rs}"
  fi

  printf '  %s\n' "$_pline"
  printf '  %bRuntime:%b %b%s%b  ·  %bDoor:%b https://compute.tarx.com (gateway :%s)\n' \
    "$_dm" "$_rs" "$_rcol" "$_runtime" "$_rs" "$_dm" "$_rs" "$SUPERCOMPUTER_GATEWAY_PORT"
  printf '  %bWatchers:%b runtime-health %b%s%b · memory-consolidation %b%s%b\n' \
    "$_dm" "$_rs" "$(_wcol "$_health")" "$_health" "$_rs" "$(_wcol "$_consol")" "$_consol" "$_rs"
  [ -n "${_last:-}" ] && printf '  %bLast reassessment:%b %s%b\n' "$_dm" "$_rs" "$_last" "$_stale"

  # Action line ONLY when runtime is not on (spec §5, §12.4).
  case "$_runtime" in
    up) : ;;  # omit when on
    *)  printf '  %bTurn TARX on:%b tarx on\n' "$_dm" "$_rs" ;;
  esac
}

cmd_arm() {   # user intent only — explicit arming per §9
  "$HOME/.tarx/bin/tarx-presence.sh" set-mode "$1" >/dev/null 2>&1 || true
  cmd_presence
}

print_logo() {
  # Spec v1.1 landing mark. Cyan mark only (not bold). Plain/non-tty/NO_COLOR
  # drop to a single sigil line. Austin stays on the sigil.
  _plain=0
  [ -n "${NO_COLOR:-}" ] && _plain=1
  [ "${TARX_PLAIN:-}" = "1" ] && _plain=1
  [ -t 1 ] || _plain=1
  case " $* " in *" --plain "*) _plain=1 ;; esac

  if [ "$_plain" = "1" ]; then
    printf 'TARX  ·  FREE TO THINK  ·  v1.1.0  ·  Designed in Austin TX.\n\n'
    return
  fi

  _cy='\033[36m'; _dm='\033[2m'; _rs='\033[0m'
  printf '%b' "$_cy"
  cat <<'ART'

        *****      ******      *****
       *******     ******     *******
      ********    ********    ********
      *********   ********    ********
     **********  **********  **********
     ***** ***** ********** ***** *****
     ***** **********  ********** ******
    *****  **********  **********  *****
      **    *********  *********
            ********    ********
             ******      ******
****          ****        ****          ****
****                                    ****
*****                                  *****
 *****                                *****
  ******                            ******
    ******                        ******
     *******                    *******
       **********           *********
          ************************
              ****************
ART
  printf '%b' "$_rs"
  printf '%b              FREE TO THINK  ·  v1.1.0  ·  Designed in Austin TX.%b\n\n' "$_dm" "$_rs"
}

cmd_help() {
  print_logo

  # Always On · Presence (the on-switch, not a chat). §5.1 / §17.
  cmd_presence
  printf '\n'

  cat <<'USAGE'
TARX — Local AI Engine

Usage: tarx <command> [options]

Commands:
  on                Turn TARX on (arm Always On presence)
  off               Set TARX to Asleep (here when you want it)
  dnd               Armed, Do Not Disturb
  presence          Show Always On presence and vital signs
  flywheel          Watch the live build-loop activity feed (tail|stats)
  code              TARX Code — local-first coding agent
  code "prompt"     One-shot coding task
  start             Start all services (inference, mesh, embeddings)
  stop              Graceful shutdown of all services
  status            Health check all services
  chat              Talk to TARX (interactive · Supercomputer door)
  chat "prompt"     Quick inference via local model
  embed <file>      Chunk and embed file into RAG store
  search "query"    Semantic search across embedded files
  mesh status       Mesh network info
  mesh join         Opt into mesh network
  mcp add claude    Connect TARX to Claude Desktop
  mcp add cc        Connect TARX to Claude Code
  mcp add cursor    Connect TARX to Cursor
  mcp add vscode    Connect TARX to VS Code
  mcp status        Check MCP config across all clients
  spaces list       List project spaces
  spaces create     Create a new project space
  update            Update daemon, CLI, and MCP servers in-place
  update --force    Force update even if already on latest
  update --models   Check model status
  uninstall         Remove TARX (asks before deleting data)
  version           Print version
  tray              Launch menu bar tray icon
  doctor            Diagnose issues (ports, disk, RAM, GPU, models)
  help              Show this help

Ports:
  Supercomputer door (public via https://compute.tarx.com):
    11450  Supercomputer gateway (OpenAI-compatible door)
    11445  Supercomputer base model (tarx-brain-qwen-27b)
  Local-only (loopback, not the Supercomputer door):
    11435  Mind (local inference)
    11436  Mesh (local)
    11437  Embeddings (local)
    11438  Cognitive engine (local)
    11440  Bridge (local)

Docs: https://tarx.com/docs
USAGE
}

# ── Main dispatch ────────────────────────────────────────────────────

_cmd="${1:-__live__}"
shift 2>/dev/null || true

case "$_cmd" in
  code)      exec "$HOME/.tarx/bin/tarx-code" "$@" ;;
  on)        cmd_arm armed ;;
  off)       cmd_arm asleep ;;
  dnd)       cmd_arm dnd ;;
  presence)  cmd_presence ;;
  flywheel)  shift 2>/dev/null||true; "$HOME/.tarx/bin/tarx-flywheel.sh" "${1:-tail}" ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  status)    cmd_status ;;
  __live__)  print_logo; cmd_presence; printf '\n'; cmd_chat ;;
  chat)      cmd_chat "$@" ;;
  embed)     cmd_embed "$@" ;;
  search)    cmd_search "$@" ;;
  mesh)      cmd_mesh "$@" ;;
  mcp)       cmd_mcp "$@" ;;
  spaces)    cmd_spaces "$@" ;;
  update)    cmd_update "$@" ;;
  uninstall) cmd_uninstall ;;
  version)   cmd_version ;;
  tray)      cmd_tray ;;
  doctor)    cmd_doctor; exit $? ;;
  help|--help|-h) cmd_help ;;
  *)
    printf 'Unknown command: %s\n\n' "$_cmd" >&2
    cmd_help >&2
    exit 1
    ;;
esac
