# ── tray ────────────────────────────────────────────────────────────

cmd_tray() {
  # Launch the standalone menu bar tray app
  _tray_dir=""
  # Check common locations for the tray app
  for _d in \
    "${HOME}/Desktop/tarx-code-oss/apps/tarx-tray" \
    "/Applications/TARX Workbench.app/Contents/Resources/apps/tarx-tray" \
    "${HOME}/.tarx/apps/tarx-tray"; do
    if [ -f "${_d}/main.js" ]; then
      _tray_dir="$_d"
      break
    fi
  done

  if [ -z "$_tray_dir" ]; then
    err "Tray app not found. Ensure tarx-code-oss is present at ~/Desktop/tarx-code-oss"
  fi

  # Find Electron binary
  _electron=""
  for _e in \
    "${_tray_dir}/../../.build/electron/TARX Workbench.app/Contents/MacOS/Electron" \
    "/Applications/TARX Workbench.app/Contents/MacOS/Electron"; do
    if [ -x "$_e" ]; then
      _electron="$_e"
      break
    fi
  done

  if [ -z "$_electron" ]; then
    err "Electron binary not found. Build tarx-code-oss or install TARX Workbench."
  fi

  log "Starting TARX tray..."
  exec "$_electron" "$_tray_dir"
}

# ── mcp ──────────────────────────────────────────────────────────────

# Detect config file path for each AI client
_mcp_config_path() {
  _client="$1"
  if [ -n "${TARX_MCP_CONFIG_DIR:-}" ]; then
    echo "${TARX_MCP_CONFIG_DIR}/${_client}.json"
    return
  fi
  case "$_client" in
    claude)
      # Claude Desktop (macOS)
      if [ "$_os" = "Darwin" ]; then
        echo "$HOME/Library/Application Support/Claude/claude_desktop_config.json"
      else
        # Linux — Claude Desktop uses XDG or ~/.config
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/Claude/claude_desktop_config.json"
      fi
      ;;
    claude-code)
      echo "$HOME/.claude.json"
      ;;
    cursor)
      echo "$HOME/.cursor/mcp.json"
      ;;
    vscode)
      if [ "$_os" = "Darwin" ]; then
        echo "$HOME/Library/Application Support/Code/User/mcp.json"
      else
        echo "${XDG_CONFIG_HOME:-$HOME/.config}/Code/User/mcp.json"
      fi
      ;;
  esac
}

# MCP clients do not yet share a standard configuration envelope.
_mcp_root_key() {
  case "$1" in
    vscode) echo "servers" ;;
    *)      echo "mcpServers" ;;
  esac
}

# Public TARX MCP server definitions for manual installation.
_mcp_tarx_servers_json() {
  _target="$1"
  _tarx_home="${TARX_HOME:-$HOME/.tarx}"
  if [ "$_target" = "vscode" ]; then
    _remote_type='"type": "http",'
    _local_type='"type": "stdio",'
  else
    _remote_type=""
    _local_type=""
  fi
  cat << SERVERSEOF
{
    "tarx": {
      ${_remote_type}
      "url": "https://mcp.tarx.com/mcp"
    },
    "tarx-core": {
      ${_local_type}
      "command": "node",
      "args": ["${_tarx_home}/servers/tarx-core/dist/server.js"],
      "env": {
        "TARX_INFERENCE_URL": "http://localhost:11435",
        "TARX_EMBEDDING_URL": "http://localhost:11437",
        "TARX_MESH_URL": "http://localhost:11436"
      }
    }
  }
SERVERSEOF
}

cmd_mcp() {
  _subcmd="${1:-help}"
  shift 2>/dev/null || true

  case "$_subcmd" in
    add)
      _target="${1:-}"
      if [ -z "$_target" ]; then
        err "Usage: tarx mcp add <target> (available: claude, claude-code, cursor, vscode)"
      fi

      _config_file=""
      _client_name=""
      _root_key=""
      case "$_target" in
        claude)
          _config_file="$(_mcp_config_path claude)"
          _client_name="Claude Desktop"
          ;;
        claude-code|cc)
          _target="claude-code"
          _config_file="$(_mcp_config_path claude-code)"
          _client_name="Claude Code"
          ;;
        cursor)
          _config_file="$(_mcp_config_path cursor)"
          _client_name="Cursor"
          ;;
        vscode|code)
          _target="vscode"
          _config_file="$(_mcp_config_path vscode)"
          _client_name="VS Code"
          ;;
        *)
          err "Unknown target: $_target (available: claude, claude-code, cursor, vscode)"
          ;;
      esac
      _root_key="$(_mcp_root_key "$_target")"

      if [ -z "$_config_file" ]; then
        err "Could not determine config path for $_target"
      fi

      if [ "$_target" = "vscode" ] && [ -f "$HOME/.vscode/mcp.json" ]; then
        warn "Legacy TARX VS Code config found at $HOME/.vscode/mcp.json"
        warn "VS Code's user config now lives at $_config_file"
      fi

      # Require python3 for safe JSON merge
      if ! command -v python3 >/dev/null 2>&1; then
        warn "python3 required for safe config merge"
        log ""
        log "  Add this manually to $_config_file:"
        log ""
        printf '  {\n    "%s": %s\n  }\n' "$_root_key" "$(_mcp_tarx_servers_json "$_target")"
        return
      fi

      # Create parent dir
      mkdir -p "$(dirname "$_config_file")" 2>/dev/null || true

      # Backup existing config
      if [ -f "$_config_file" ]; then
        cp "$_config_file" "${_config_file}.bak" 2>/dev/null || true
      fi

      # Merge using the client-specific envelope without touching other entries.
      python3 << PYEOF
import json, sys, os

config_path = "$_config_file"
target = "$_target"
root_key = "$_root_key"

# Read existing config or start fresh
config = {}
if os.path.exists(config_path):
    try:
        with open(config_path, 'r') as f:
            config = json.load(f)
    except (json.JSONDecodeError, ValueError) as exc:
        print(f"  ERROR: Existing config is not valid JSON: {exc}", file=sys.stderr)
        print(f"  Original preserved at {config_path}.bak", file=sys.stderr)
        sys.exit(1)

if root_key not in config:
    config[root_key] = {}
if not isinstance(config[root_key], dict):
    print(f"  ERROR: Existing {root_key} value is not an object.", file=sys.stderr)
    sys.exit(1)

# VS Code requires a servers envelope and explicit transport types. Claude and
# Cursor use an mcpServers envelope; local stdio entries need no type field.
tarx_home = os.path.expanduser(os.environ.get("TARX_HOME", "~/.tarx"))
tarx_servers = {
    "tarx": {
        "url": "https://mcp.tarx.com/mcp"
    },
    "tarx-core": {
        "command": "node",
        "args": [os.path.join(tarx_home, "servers/tarx-core/dist/server.js")],
        "env": {
            "TARX_INFERENCE_URL": "http://localhost:11435",
            "TARX_EMBEDDING_URL": "http://localhost:11437",
            "TARX_MESH_URL": "http://localhost:11436"
        }
    }
}
if target == "vscode":
    tarx_servers["tarx"]["type"] = "http"
    tarx_servers["tarx-core"]["type"] = "stdio"

# Merge — add or replace TARX servers, preserve everything else
for name, server_config in tarx_servers.items():
    config[root_key][name] = server_config

# Write
with open(config_path, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')

# Validate the client-specific envelope and TARX entries.
with open(config_path, 'r') as f:
    validated = json.load(f)

valid_root = validated.get(root_key, {})
valid = (
    isinstance(valid_root, dict)
    and all(isinstance(valid_root.get(name), dict) for name in tarx_servers)
)
if target == "vscode":
    valid = valid and valid_root["tarx"].get("type") == "http"
    valid = valid and valid_root["tarx-core"].get("type") == "stdio"

if not valid:
    # Restore backup
    bak = config_path + '.bak'
    if os.path.exists(bak):
        os.replace(bak, config_path)
    print("  ERROR: Validation failed. Config restored from backup.", file=sys.stderr)
    sys.exit(1)

# Clean up backup on success
bak = config_path + '.bak'
if os.path.exists(bak):
    os.remove(bak)

print("  ok")
PYEOF

      if [ $? -ne 0 ]; then
        err "Config write failed. Check $_config_file and retry."
      fi

      log ""
      log "  ✓ TARX added to $_client_name"
      log ""
      log "  → Restart $_client_name to activate TARX tools"
      log "  → Docs: howdy.tarx.com/quickstart"
      log ""
      ;;
    status)
      log "  MCP Configuration Status"
      log "  ════════════════════════"
      log ""
      for _c in claude claude-code cursor vscode; do
        _cf="$(_mcp_config_path "$_c")"
        case "$_c" in
          claude)      _cn="Claude Desktop" ;;
          claude-code) _cn="Claude Code" ;;
          cursor)      _cn="Cursor" ;;
          vscode)      _cn="VS Code" ;;
        esac
        if [ -f "$_cf" ] && grep -q '"tarx"' "$_cf" 2>/dev/null; then
          printf '  [OK] %-16s %s\n' "$_cn" "$_cf"
        elif [ "$_c" = "vscode" ] && [ -f "$HOME/.vscode/mcp.json" ]; then
          printf '  [!!] %-16s legacy config at %s (run: tarx mcp add vscode)\n' "$_cn" "$HOME/.vscode/mcp.json"
        else
          printf '  [--] %-16s not configured\n' "$_cn"
        fi
      done
      log ""
      log "  Remote: https://mcp.tarx.com/mcp"
      log "  Fix:    tarx mcp add <target>"
      log ""
      ;;
    *)
      err "Unknown mcp command: $_subcmd (available: add, status)"
      ;;
  esac
}

