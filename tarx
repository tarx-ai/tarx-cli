#!/bin/sh
# TARX CLI — local AI engine control plane
# Usage: tarx <command> [options]

set -e

TARX_VERSION="1.1.0"

# ── Platform paths ───────────────────────────────────────────────────

_os="$(uname -s)"
case "$_os" in
  Darwin) TARX_DATA="${HOME}/Library/Application Support/tarx" ;;
  *)      TARX_DATA="${HOME}/.tarx" ;;
esac

TARX_MODELS="${TARX_DATA}/models"
TARX_LOGS="${TARX_DATA}/logs"
TARX_PID_DIR="${TARX_DATA}/pids"
INFERENCE_PORT=11435
MESH_PORT=11436
EMBED_PORT=11437
COGNITIVE_PORT=11438

INFERENCE_MODEL="tarx-qwen2.5-7b-deep-Q4_K_M.gguf"
EMBED_MODEL="nomic-embed-text-v1.5-f16.gguf"

# ── Helpers ──────────────────────────────────────────────────────────

log() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
err() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

ensure_dirs() {
  mkdir -p "$TARX_LOGS" "$TARX_PID_DIR" 2>/dev/null || true
}

check_port() {
  curl -sf "http://127.0.0.1:${1}/health" >/dev/null 2>&1
}

pid_file() {
  echo "${TARX_PID_DIR}/${1}.pid"
}

is_running() {
  _pf="$(pid_file "$1")"
  if [ -f "$_pf" ]; then
    _pid=$(cat "$_pf")
    if kill -0 "$_pid" 2>/dev/null; then
      return 0
    fi
    rm -f "$_pf"
  fi
  return 1
}

find_llama_server() {
  # Check common locations
  for _path in \
    /opt/homebrew/bin/llama-server \
    /usr/local/bin/llama-server \
    "${HOME}/.local/bin/llama-server" \
    "$(command -v llama-server 2>/dev/null || true)"; do
    if [ -n "$_path" ] && [ -x "$_path" ]; then
      echo "$_path"
      return 0
    fi
  done
  return 1
}

find_mesh_binary() {
  for _path in \
    "${HOME}/Desktop/tarx-mesh/target/release/tarx-mesh" \
    /usr/local/bin/tarx-mesh \
    "$(command -v tarx-mesh 2>/dev/null || true)"; do
    if [ -n "$_path" ] && [ -x "$_path" ]; then
      echo "$_path"
      return 0
    fi
  done
  return 1
}

# ── start ────────────────────────────────────────────────────────────

cmd_start() {
  ensure_dirs
  log "Starting TARX services..."

  _started=0

  # 1. Inference server (port 11435)
  if check_port $INFERENCE_PORT; then
    log "  Inference  (${INFERENCE_PORT}): already running"
  else
    _llama="$(find_llama_server)" || true
    _model_path="${TARX_MODELS}/${INFERENCE_MODEL}"

    if [ -z "$_llama" ]; then
      warn "llama-server not found — install with: brew install llama.cpp"
    elif [ ! -f "$_model_path" ]; then
      warn "Inference model not found at ${_model_path}"
      warn "Download with: tarx update --models"
    else
      "$_llama" \
        --host 127.0.0.1 \
        --port $INFERENCE_PORT \
        --model "$_model_path" \
        --ctx-size 8192 \
        --parallel 2 \
        --no-warmup \
        > "${TARX_LOGS}/inference.log" 2>&1 &
      echo $! > "$(pid_file inference)"
      log "  Inference  (${INFERENCE_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  # 2. Embedding server (port 11437)
  if check_port $EMBED_PORT; then
    log "  Embeddings (${EMBED_PORT}): already running"
  else
    _llama="$(find_llama_server)" || true
    _embed_path="${TARX_MODELS}/${EMBED_MODEL}"

    if [ -z "$_llama" ]; then
      warn "llama-server not found — install with: brew install llama.cpp"
    elif [ ! -f "$_embed_path" ]; then
      warn "Embedding model not found at ${_embed_path}"
      warn "Download with: tarx update --models"
    else
      "$_llama" \
        --host 127.0.0.1 \
        --port $EMBED_PORT \
        --model "$_embed_path" \
        --ctx-size 8192 \
        --embeddings \
        --pooling mean \
        --parallel 1 \
        --no-warmup \
        > "${TARX_LOGS}/embeddings.log" 2>&1 &
      echo $! > "$(pid_file embeddings)"
      log "  Embeddings (${EMBED_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  # 3. Mesh server (port 11436)
  if check_port $MESH_PORT; then
    log "  Mesh       (${MESH_PORT}): already running"
  else
    _mesh="$(find_mesh_binary)" || true
    if [ -z "$_mesh" ]; then
      log "  Mesh       (${MESH_PORT}): binary not found (optional)"
    else
      TARX_MESH_BIND="127.0.0.1:${MESH_PORT}" "$_mesh" \
        > "${TARX_LOGS}/mesh.log" 2>&1 &
      echo $! > "$(pid_file mesh)"
      log "  Mesh       (${MESH_PORT}): starting (pid $!)"
      _started=$(( _started + 1 ))
    fi
  fi

  if [ $_started -gt 0 ]; then
    log ""
    log "Waiting for services..."
    sleep 3
    cmd_status
  else
    log ""
    log "All services already running."
  fi
}

# ── stop ─────────────────────────────────────────────────────────────

cmd_stop() {
  log "Stopping TARX services..."

  for _svc in inference embeddings mesh; do
    _pf="$(pid_file "$_svc")"
    if [ -f "$_pf" ]; then
      _pid=$(cat "$_pf")
      if kill -0 "$_pid" 2>/dev/null; then
        kill "$_pid" 2>/dev/null || true
        log "  Stopped ${_svc} (pid ${_pid})"
      fi
      rm -f "$_pf"
    else
      # Try to find by port
      case "$_svc" in
        inference)  _port=$INFERENCE_PORT ;;
        embeddings) _port=$EMBED_PORT ;;
        mesh)       _port=$MESH_PORT ;;
      esac
      _pid=$(lsof -ti ":${_port}" 2>/dev/null | head -1) || true
      if [ -n "$_pid" ]; then
        kill "$_pid" 2>/dev/null || true
        log "  Stopped ${_svc} (pid ${_pid})"
      else
        log "  ${_svc}: not running"
      fi
    fi
  done

  log "Done."
}

# ── status ───────────────────────────────────────────────────────────

cmd_status() {
  log "TARX Service Status"
  log "═══════════════════"
  log ""
  printf '  %-14s %-8s %s\n' "SERVICE" "PORT" "STATUS"
  printf '  %-14s %-8s %s\n' "──────────" "─────" "──────"

  for _svc_info in "Inference:${INFERENCE_PORT}" "Mesh:${MESH_PORT}" "Embeddings:${EMBED_PORT}" "Cognitive:${COGNITIVE_PORT}"; do
    _name="${_svc_info%%:*}"
    _port="${_svc_info##*:}"

    if check_port "$_port"; then
      _status="running"
    elif is_running "$(echo "$_name" | tr '[:upper:]' '[:lower:]')"; then
      _status="starting"
    else
      _status="stopped"
    fi

    printf '  %-14s %-8s %s\n' "$_name" "$_port" "$_status"
  done

  log ""
}

# ── chat ─────────────────────────────────────────────────────────────

_tarx_session() {
  if ! command -v python3 >/dev/null 2>&1; then
    err "TARX needs Python 3 on this computer before it can continue."
  fi
  # The program is on fd 3 so the terminal stays attached to the conversation.
  TARX_CHAT_TEXT="${1-}" python3 /dev/fd/3 3<< 'PY'
import json, os, select, subprocess, sys, urllib.error, urllib.request
from pathlib import Path

HOME = Path(os.environ.get("HOME", ""))
KEY_PATH = HOME / ".tarx" / "state" / "chat-key"
PENDING_PATH = HOME / ".tarx" / "state" / "pending-turn"
AUTH = os.environ.get("TARX_AUTH_ORIGIN", "https://tarx.com").rstrip("/")
DOOR = "https://compute.tarx.com/v1/chat/completions"

# Session-only history: never persisted or shared across credential changes.
HISTORY = []
HISTORY_KEY = None
LABEL_CACHE = {}
MAX_INPUT_BYTES = 12000
MAX_CONTEXT_BYTES = 24000

def host_capabilities():
    """Executable wiring only. Not the user's words and not a roadmap."""
    return {
        "text_reply": "available",
        "session_history": "available",
        "memory_write": "unavailable",
        "file_read": "unavailable",
        "agent_creation": "unavailable",
        "voice": "unavailable",
        "delegation": "unavailable",
        "signed_in_web": "not_observed",
        "lumbergh_tasks": "unavailable",
    }

def capability_reply():
    caps = host_capabilities()
    return (
        "This terminal can send this conversation to the supercomputer and show the text reply. "
        "History stays in this session only and is cleared when the account changes.\n"
        "Not available on this path: memory writes (" + caps["memory_write"] + "), "
        "file reads (" + caps["file_read"] + "), agent creation (" + caps["agent_creation"] + "), "
        "voice controls (" + caps["voice"] + "), delegation (" + caps["delegation"] + "), "
        "and durable Lumbergh tasks (" + caps["lumbergh_tasks"] + ").\n"
        "Signed-in web proof: " + caps["signed_in_web"] + ".\n"
        "Naming a feature in your message does not make it available."
    )

def asks_capabilities(text):
    low = " ".join(text.lower().split())
    explicit = (
        "what can you do",
        "what did you say you can",
        "which of these do you",
        "which of these are available",
        "what capabilities do you",
        "capability status",
    )
    return any(phrase in low for phrase in explicit)

def guard_reply(text):
    import re
    unquoted = re.sub(r'"[^"]*"|\'[^\']*\'', "", text)
    if re.search(r"\b(not available|cannot|can't|do not have|does not have)\b", unquoted, re.I):
        return text
    claim = re.compile(
        r"(memory (is|writes are) available|i can (read|write) (a )?file|voice controls are available|signed-in web (is|was) (proved|proven)|durable lumbergh task is saved)",
        re.I,
    )
    if claim.search(unquoted):
        return capability_reply()
    return text

def reset_history():
    global HISTORY_KEY
    HISTORY.clear()
    HISTORY_KEY = None
    LABEL_CACHE.clear()

def read_message():
    """Bracketed paste is one message. Enter submits; Ctrl-C cancels input."""
    if not sys.stdin.isatty():
        return sys.stdin.readline()
    import codecs, termios, tty
    fd = sys.stdin.fileno()
    previous = termios.tcgetattr(fd)
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    chars, cursor, pasted = [], 0, False
    def paint():
        sys.stdout.write("\r\x1b[2K> " + "".join(chars).replace("\n", "↵"))
        if cursor < len(chars):
            sys.stdout.write("\x1b[%dD" % (len(chars) - cursor))
        sys.stdout.flush()
    try:
        tty.setcbreak(fd)
        attrs = termios.tcgetattr(fd)
        attrs[0] &= ~(termios.IXON | termios.IXOFF)
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
        sys.stdout.write("\x1b[?2004h")
        paint()
        while True:
            ch = decoder.decode(os.read(fd, 1))
            if not ch:
                continue
            if ch == "\x07":
                pasted = False
                paint()
                continue
            if ch == "\x1b":
                seq = ""
                while select.select([fd], [], [], .03)[0]:
                    seq += os.read(fd, 1).decode("ascii", errors="ignore")
                    if seq.endswith("~") or (seq.startswith("[") and seq[-1:] in "ABCD"):
                        break
                if seq == "[200~":
                    pasted = True
                elif seq == "[201~":
                    pasted = False
                elif not pasted and seq == "[D":
                    cursor = max(0, cursor - 1)
                elif not pasted and seq == "[C":
                    cursor = min(len(chars), cursor + 1)
                paint()
                continue
            if ch in ("\n", "\r") and not pasted:
                sys.stdout.write("\n")
                return "".join(chars) + "\n"
            if ch == "\x04" and not chars:
                sys.stdout.write("\n")
                return ""
            if ch in ("\x7f", "\b") and not pasted:
                if cursor:
                    cursor -= 1
                    chars.pop(cursor)
            elif ch == "\x15" and not pasted:
                chars, cursor = [], 0
            elif ch == "\t" or ch in ("\n", "\r") or ch.isprintable():
                chars.insert(cursor, "\n" if ch == "\r" else ch)
                cursor += 1
            if not pasted:
                paint()
    except KeyboardInterrupt:
        sys.stdout.write("\nInput cancelled.\n")
        return "\n"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, previous)
        sys.stdout.write("\x1b[?2004l")
        sys.stdout.flush()


def say(text):
    print(text, flush=True)

def http(method, url, body=None, headers=None, timeout=20):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("content-type", "application/json")
    for name, value in (headers or {}).items():
        req.add_header(name, value)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            raw = res.read().decode()
            return res.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as error:
        raw = error.read().decode()
        try:
            parsed = json.loads(raw) if raw else {}
        except json.JSONDecodeError:
            parsed = {}
        return error.code, parsed
    except (urllib.error.URLError, TimeoutError, OSError):
        return 0, {}

def read_key():
    env = os.environ.get("TARX_CHAT_KEY", "").strip()
    if env:
        return env
    try:
        return KEY_PATH.read_text().strip()
    except OSError:
        return ""

def write_key(value):
    reset_history()
    KEY_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = KEY_PATH.with_name("chat-key.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, (value.strip() + "\n").encode())
    finally:
        os.close(fd)
    os.replace(tmp, KEY_PATH)
    os.chmod(KEY_PATH, 0o600)

def new_request_id():
    import uuid
    return str(uuid.uuid4())

def save_pending(text, request_id="", state="held"):
    PENDING_PATH.parent.mkdir(parents=True, exist_ok=True)
    raw = text.strip()
    if not raw:
        return
    record = {"text": raw, "request_id": request_id or new_request_id(), "state": state}
    fd = os.open(PENDING_PATH, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, (json.dumps(record) + "\n").encode())
    finally:
        os.close(fd)
    os.chmod(PENDING_PATH, 0o600)

def load_pending():
    try:
        raw = PENDING_PATH.read_text().strip()
    except OSError:
        return None
    if not raw:
        return None
    try:
        record = json.loads(raw)
    except json.JSONDecodeError:
        record = {"text": raw, "request_id": new_request_id(), "state": "held"}
    if not isinstance(record, dict) or not str(record.get("text") or "").strip():
        return None
    record["text"] = str(record["text"]).strip()
    record["request_id"] = str(record.get("request_id") or new_request_id())
    record["state"] = "unconfirmed" if record.get("state") == "unconfirmed" else "held"
    return record

def drop_pending():
    try:
        PENDING_PATH.unlink()
    except OSError:
        pass

def pending_decision(record, typed):
    """Do not send a held draft without confirmation, and do not retry an unconfirmed send unless asked."""
    word = " ".join(typed.strip().lower().split())
    if word == "drop":
        return "drop"
    if record.get("state") == "unconfirmed":
        return "retry" if word == "retry" else "wait"
    return "send" if word == "send" else "wait"

def clear_key():
    reset_history()
    try:
        KEY_PATH.unlink()
    except FileNotFoundError:
        pass

def introspect(key):
    status, body = http("POST", AUTH + "/api/auth/cli/introspect", {"token": key}, timeout=10)
    if status == 200 and body.get("ok") is True:
        return "ok"
    if status in (401, 403):
        return "no"
    return "unknown"

def show_commands():
    say("/agents     who can work")
    say("/channels   rooms you can open")
    say("/signin     connect this computer")

def handle_command(text):
    low = " ".join(text.strip().lower().split())
    if low in {"/agents", "/agent"}:
        say("Always On is the agent in this conversation.")
        say("Specialist execution is not connected to this CLI yet.")
        say("This conversation currently supports text replies.")
        return True
    if low in {"/channels", "/channel"}:
        say("Channels are rooms. Looking does not join the room.")
        say("Open https://tarx.com/agent to view available channels.")
        return True
    if low in {"/help", "/?"}:
        show_commands()
        return True
    if low in {"/signin", "/sign-in", "sign in", "signin"}:
        return "signin"
    return False

def guest_command(text):
    low = " ".join(text.strip().lower().split())
    if low in {"agents", "channels", "help"}:
        return handle_command("/" + low)
    return handle_command(text)

def lobby(reconnect):
    if reconnect:
        say("Your session expired. You can keep looking, or connect this computer again.")
    else:
        say("Welcome to TARX.")
        say("You can look around before connecting an account.")
    show_commands()
    while True:
        line = read_message()
        if line == "":
            return ""
        text = line.strip()
        if not text:
            continue
        if text.lower() in {"exit", "quit"}:
            return ""
        found = guest_command(text)
        if found == "signin":
            key = begin_sign_in()
            if key:
                return key
            say("You can keep looking.")
            show_commands()
            continue
        if found:
            continue
        if asks_identity(text):
            say("This visit is not connected, so there is no account name yet.")
            say("Say /signin to connect this computer.")
            continue
        save_pending(text)
        say("That message was not sent. It is saved on this computer.")
        say("Say /signin to connect this computer.")
        show_commands()

def refresh_label(key):
    if key in LABEL_CACHE:
        return LABEL_CACHE[key]
    status, body = http("POST", AUTH + "/api/auth/cli/introspect", {"token": key}, timeout=10)
    if status == 200 and body.get("ok") is True:
        LABEL_CACHE.clear()
        LABEL_CACHE[key] = body.get("label", "").strip() if isinstance(body.get("label"), str) else ""
        return LABEL_CACHE[key]
    return ""

def wake_always_on():
    label = refresh_label(read_key())
    say("TARX chat")
    if label:
        say("You are " + label + ", and this computer is connected.")
    else:
        say("This computer is connected, and I'll stay in this conversation.")
    say("Recent conversation context stays in this session. Sign out to clear it.")
    say("Paste your message, then press Enter to send. Ctrl-C cancels input.")
    show_commands()

def asks_identity(text):
    cleaned = "".join(ch if ch.isalnum() or ch.isspace() else " " for ch in text.lower())
    cleaned = " ".join(cleaned.split())
    return cleaned in {"who am i", "whoami", "if i am authed who am i", "if i am authenticated who am i"}

def say_pending(key, record):
    label = refresh_label(key) or "this connected computer, with no account name on the sign-in"
    say("Saved message, not sent:")
    say(record["text"])
    say("Destination: " + label + ".")
    if record.get("state") == "unconfirmed":
        say("The previous send may have reached TARX. It was not repeated.")
        say("Type retry to send it again, or drop to discard it.")
        return
    say("Type send to deliver it to that account, or drop to discard it.")

def deliver_pending(key, record):
    kind, text = reply_for(key, record["text"])
    say(text)
    if kind == "ok":
        drop_pending()
        return 0
    if kind == "expired":
        clear_key()
        save_pending(record["text"], record["request_id"], "held")
        say("The sign-in expired. The message is still saved and was not sent.")
        return 1
    save_pending(record["text"], record["request_id"], "unconfirmed")
    say("That send did not finish. It was not repeated.")
    say("Type retry only if you did not get an answer, or drop to discard it.")
    return 1

def say_who(key):
    label = refresh_label(key)
    if label:
        say("You are " + label + ".")
        say("I am TARX, Always On.")
        return
    say("This computer is connected, but this sign-in did not keep your account name.")
    say("Say /signin once more. I will keep the name from that approval.")

def begin_sign_in():
    status, body = http("POST", AUTH + "/api/auth/device", {}, timeout=20)
    device = body.get("device_code") if status == 200 else ""
    url = body.get("verification_uri") if isinstance(body.get("verification_uri"), str) else ""
    code = body.get("user_code") if isinstance(body.get("user_code"), str) else ""
    if not device or not (url.startswith(AUTH + "/auth/device?") or url.startswith(AUTH + "/agent?cli=")):
        say("Sign-in is unavailable. Try again in a moment.")
        return ""
    say("Finish signing in in your browser. I'll pick up here when you're done.")
    say("This terminal's code is " + code + ".")
    say(url)
    if sys.platform == "darwin" and os.environ.get("TARX_AUTH_NO_BROWSER") != "1":
        subprocess.Popen(["open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    deadline = time_left(body.get("expires_in"))
    interval = body.get("interval") if isinstance(body.get("interval"), int) else 2
    interval = 2 if interval < 2 else interval
    watch = True
    while time_left_remaining(deadline):
        if watch:
            ready, _, _ = select.select([sys.stdin], [], [], interval)
            if ready:
                typed = sys.stdin.readline()
                if typed == "":
                    watch = False
                elif typed.strip().lower() in {"cancel", "quit", "exit"}:
                    return finish_cancel(device)
        else:
            time_sleep(interval)
        status, polled = http("POST", AUTH + "/api/auth/device/poll", {"device_code": device}, timeout=10)
        state = polled.get("status")
        if state == "complete" and isinstance(polled.get("credential"), str):
            write_key(polled["credential"])
            wake_always_on()
            return read_key()
        if state == "denied":
            say("That sign-in was declined.")
            return ""
        if state == "expired" or status == 400:
            say("That sign-in expired. Run tarx to try again.")
            return ""
    return finish_cancel(device, expired=True)

def finish_cancel(device, expired=False):
    status, body = http("POST", AUTH + "/api/auth/device/cancel", {"device_code": device}, timeout=10)
    if status == 200 and body.get("ok") is True:
        say("That sign-in expired. Run tarx to try again." if expired else "Sign-in cancelled.")
        return ""
    status, polled = http("POST", AUTH + "/api/auth/device/poll", {"device_code": device}, timeout=10)
    state = polled.get("status")
    if state == "complete" and isinstance(polled.get("credential"), str):
        write_key(polled["credential"])
        say("This terminal was already approved.")
        wake_always_on()
        return read_key()
    if state == "canceled":
        say("Sign-in cancelled.")
        return ""
    say("That sign-in expired. Run tarx to try again." if expired else "Sign-in could not be cancelled. Run tarx to try again.")
    return ""

def time_left(value):
    import time
    seconds = value if isinstance(value, int) else 600
    return time.time() + max(30, min(seconds, 600))

def time_left_remaining(deadline):
    import time
    return time.time() < deadline

def time_sleep(seconds):
    import time
    time.sleep(seconds)

def reply_for(key, prompt):
    global HISTORY_KEY
    if len(prompt.encode("utf-8")) > MAX_INPUT_BYTES:
        return "input", "That message is too large. Please keep it under 12,000 UTF-8 bytes."
    if HISTORY_KEY != key:
        reset_history()
        HISTORY_KEY = key
    messages = HISTORY.copy()
    while messages and (len(messages) >= 12 or len(json.dumps(messages, ensure_ascii=False).encode("utf-8")) + len(prompt.encode("utf-8")) > MAX_CONTEXT_BYTES):
        del messages[:2]
    if asks_capabilities(prompt):
        answer = capability_reply()
        HISTORY[:] = messages + [
            {"role": "user", "content": prompt},
            {"role": "assistant", "content": answer},
        ]
        return "ok", answer
    messages.append({"role": "user", "content": prompt})
    label = refresh_label(key)
    if label:
        messages.insert(0, {
            "role": "system",
            "content": "You are TARX, Always On. The human signed in on this computer is " + label + ". If they ask who they are, answer with that name. Do not invent a different identity.",
        })
    status, body = http("POST", DOOR, {
        "model": "tarx/t-supercomputer",
        "messages": messages,
        "stream": False,
        "max_tokens": 768,
        "temperature": 0,
    }, headers={"Authorization": "Bearer " + key}, timeout=70)
    if status == 401:
        return "expired", ""
    if status == 429:
        return "busy", "TARX is busy right now. Wait a moment and try again."
    if status != 200:
        return "down", "TARX is temporarily unavailable. Try again in a moment."
    try:
        content = body["choices"][0]["message"]["content"].strip()
    except (KeyError, IndexError, TypeError, AttributeError):
        content = ""
    if not content:
        return "down", "TARX is temporarily unavailable. Try again in a moment."
    content = guard_reply(content)
    if body["choices"][0].get("finish_reason") == "length":
        content += "\n[Response reached its length limit. Ask me to continue.]"
    HISTORY[:] = [m for m in messages if m["role"] != "system"] + [{"role": "assistant", "content": content}]
    return "ok", content

def send_once(key, prompt):
    kind, text = reply_for(key, prompt)
    if kind == "expired":
        clear_key()
        key = lobby(True)
        if not key:
            return 1
        say("You're connected. Please send your message again; the previous message was not replayed.")
        return 0
    say(text)
    return 0 if kind == "ok" else 1

def loop():
    while True:
        line = read_message()
        if line == "":
            return 0
        text = line.strip()
        if not text:
            continue
        pending = load_pending()
        if pending and read_key():
            decision = pending_decision(pending, text)
            if decision == "drop":
                drop_pending()
                say("The saved message was discarded.")
                continue
            if decision == "wait":
                say_pending(read_key(), pending)
                continue
            if decision in {"send", "retry"}:
                if deliver_pending(read_key(), pending) != 0 and not read_key():
                    return 1
                continue
        if text.lower() in {"exit", "quit"}:
            return 0
        if text.lower() in {"sign out", "logout"}:
            key = read_key()
            if key:
                http("POST", AUTH + "/api/auth/cli/revoke", {"token": key}, timeout=10)
            clear_key()
            say("You're signed out. You can keep looking.")
            show_commands()
            continue
        found = handle_command(text) if text.startswith("/") or text.lower() in {"sign in", "signin"} else False
        if found == "signin":
            if read_key():
                say("This computer is already connected.")
            else:
                begin_sign_in()
            continue
        if found:
            continue
        key = read_key()
        if asks_identity(text):
            if not key:
                say("This visit is not connected, so there is no account name yet.")
                say("Say /signin to connect this computer.")
            else:
                say_who(key)
            continue
        if not key:
            say("That stays on this visit until the computer is connected.")
            show_commands()
            continue
        if send_once(key, text) != 0 and not read_key():
            return 1

def main():
    once = os.environ.get("TARX_CHAT_TEXT", "")
    key = read_key()
    reconnect = False
    if key:
        state = introspect(key)
        if state == "unknown":
            say("I can't confirm your connection right now. Your saved sign-in is unchanged; try again shortly.")
            return 1
        if state == "no":
            clear_key()
            key = ""
            reconnect = True
    created = False
    if not key:
        if once:
            save_pending(once)
            say("This computer is not connected, so that message was not sent.")
            say("It is saved on this computer. Run tarx, then /signin.")
            return 3
        key = lobby(reconnect)
        created = True
        if not key:
            return 0
    if once:
        return send_once(key, once)
    pending = load_pending()
    if pending:
        say_pending(key, pending)
    if not created:
        wake_always_on()
    return loop()

try:
    raise SystemExit(main())
except SystemExit:
    raise
except KeyboardInterrupt:
    say("Request interrupted. No automatic retry was sent.")
    raise SystemExit(130)
except Exception:
    say("TARX is temporarily unavailable. Try again in a moment.")
    raise SystemExit(1)
PY
}

