# ── Main dispatch ────────────────────────────────────────────────────

if [ $# -eq 0 ]; then
  cmd_front
  exit $?
fi

_cmd="${1:-help}"
shift 2>/dev/null || true

case "$_cmd" in
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  status)    cmd_status ;;
  chat)      cmd_chat "$@" ;;
  embed)     cmd_embed "$@" ;;
  search)    cmd_search "$@" ;;
  mesh)      cmd_mesh "$@" ;;
  mcp)       cmd_mcp "$@" ;;
  route)     cmd_route "$@" ;;
  spaces)    cmd_spaces "$@" ;;
  update)    cmd_update "$@" ;;
  uninstall) cmd_uninstall ;;
  version)   cmd_version ;;
  tray)      cmd_tray ;;
  doctor)    cmd_doctor ;;
  help|--help|-h) cmd_help ;;
  *)
    printf 'Unknown command: %s\n\n' "$_cmd" >&2
    cmd_help >&2
    exit 1
    ;;
esac

