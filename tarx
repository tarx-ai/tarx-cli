# ── spaces ───────────────────────────────────────────────────────────

cmd_spaces() {
  _subcmd="${1:-list}"
  shift 2>/dev/null || true

  _spaces_dir="${TARX_DATA}/spaces"
  mkdir -p "$_spaces_dir" 2>/dev/null || true

  case "$_subcmd" in
    list)
      log "Project Spaces"
      log "══════════════"
      if [ -d "$_spaces_dir" ]; then
        _count=0
        for _space in "${_spaces_dir}"/*; do
          if [ -d "$_space" ]; then
            _name=$(basename "$_space")
            _files=$(find "$_space" -type f 2>/dev/null | wc -l | tr -d ' ')
            printf '  %s (%s files)\n' "$_name" "$_files"
            _count=$((_count + 1))
          fi
        done
        if [ $_count -eq 0 ]; then
          log "  No spaces yet. Create one: tarx spaces create \"my-project\""
        fi
      fi
      ;;
    create)
      if [ -z "$1" ]; then
        err "Usage: tarx spaces create \"name\""
      fi
      _name="$1"
      _path="${_spaces_dir}/${_name}"
      if [ -d "$_path" ]; then
        err "Space '${_name}' already exists."
      fi
      mkdir -p "$_path"
      log "Created space: ${_name}"
      log "Path: ${_path}"
      ;;
    *)
      err "Unknown spaces command: $_subcmd (available: list, create)"
      ;;
  esac
}

# ── update ───────────────────────────────────────────────────────────

cmd_update() {
  log "  Checking for updates..."
  log ""

  _api_url="https://tarx.com/api/cli/latest"
  _release_json="$(curl -fsSL "$_api_url" 2>/dev/null)" || true
  if [ -z "$_release_json" ]; then
    err "Could not reach update server. Check network."
  fi

  _latest="$(echo "$_release_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['version'])" 2>/dev/null || echo "")"
  if [ -z "$_latest" ]; then
    err "Could not parse release info."
  fi

  if [ "$TARX_VERSION" = "$_latest" ] && [ "${1:-}" != "--force" ]; then
    log "  Already on latest version: v${TARX_VERSION}"
    # Check for --models flag
    if [ "${1:-}" = "--models" ]; then
      log ""
      download_models
    fi
    return
  fi

  log "  Update available: v${TARX_VERSION} -> v${_latest}"
  log ""

  # Detect platform
  _os="$(uname -s)"
  _arch="$(uname -m)"
  case "$_os" in
    Darwin) _platform="darwin" ;;
    Linux)  _platform="linux" ;;
    *)      err "Unsupported OS: $_os" ;;
  esac
  case "$_arch" in
    arm64|aarch64) _arch_key="arm64" ;;
    x86_64)        _arch_key="x64" ;;
    *)             err "Unsupported architecture: $_arch" ;;
  esac
  _target="${_platform}-${_arch_key}"

  _tarx_home="${TARX_HOME:-$HOME/.tarx}"
  _tarx_bin="${_tarx_home}/bin"

  # 1. Update daemon binary
  _daemon_url="$(echo "$_release_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['${_target}']['url'])" 2>/dev/null || echo "")"
  if [ -n "$_daemon_url" ]; then
    log "  Updating tarxd..."
    curl -fsSL "$_daemon_url" -o "${_tarx_bin}/tarxd.new" && \
      chmod +x "${_tarx_bin}/tarxd.new" && \
      mv "${_tarx_bin}/tarxd.new" "${_tarx_bin}/tarxd" && \
      log "    ✓ tarxd updated" || log "    ⚠ tarxd update failed (keeping current)"
  fi

  # 2. Update CLI
  _cli_url="https://raw.githubusercontent.com/tarx-ai/tarx-cli/main/tarx"
  log "  Updating CLI..."
  curl -fsSL "$_cli_url" -o "${_tarx_bin}/tarx.new" 2>/dev/null && \
    chmod +x "${_tarx_bin}/tarx.new" && \
    mv "${_tarx_bin}/tarx.new" "${_tarx_bin}/tarx" && \
    log "    ✓ CLI updated" || log "    ⚠ CLI update failed (keeping current)"

  # 3. Update the public MCP server bundle
  log "  Updating MCP servers..."
  _srv="tarx-core"
  _srv_url="$(echo "$_release_json" | python3 -c "import json,sys; d=json.load(sys.stdin); print(d.get('servers',{}).get('$_srv',{}).get('url',''))" 2>/dev/null || echo "")"
  if [ -n "$_srv_url" ]; then
    mkdir -p "${_tarx_home}/servers/${_srv}"
    curl -fsSL "$_srv_url" | tar xz -C "${_tarx_home}/servers/${_srv}" 2>/dev/null && \
      log "    ✓ $_srv" || log "    ⚠ $_srv update failed (keeping current)"
  fi

  # 4. Rebuild native modules if needed
  if command -v node >/dev/null 2>&1 && command -v npm >/dev/null 2>&1; then
    if [ -d "${_tarx_home}/servers/${_srv}/node_modules/better-sqlite3" ]; then
      (cd "${_tarx_home}/servers/${_srv}" && npm rebuild better-sqlite3 2>/dev/null) && \
        log "    ✓ $_srv native modules" || true
    fi
  fi

  # 5. Restart daemon if running
  if [ "$_os" = "Darwin" ]; then
    _plist="$HOME/Library/LaunchAgents/com.tarx.daemon.plist"
    if [ -f "$_plist" ]; then
      log "  Restarting daemon..."
      launchctl kickstart -k "gui/$(id -u)/com.tarx.daemon" 2>/dev/null && \
        log "    ✓ daemon restarted" || log "    ⚠ restart failed (run: launchctl kickstart -k gui/$(id -u)/com.tarx.daemon)"
    fi
  elif [ "$_os" = "Linux" ]; then
    if systemctl --user is-active tarx >/dev/null 2>&1; then
      log "  Restarting daemon..."
      systemctl --user restart tarx && \
        log "    ✓ daemon restarted" || true
    fi
  fi

  log ""
  log "  ✓ Updated to v${_latest}"
  log ""

  # Check for --models flag
  if [ "${1:-}" = "--models" ]; then
    download_models
  fi
}

download_models() {
  log "Checking models..."
  mkdir -p "$TARX_MODELS" 2>/dev/null || true

  _inference_path="${TARX_MODELS}/${INFERENCE_MODEL}"
  _embed_path="${TARX_MODELS}/${EMBED_MODEL}"

  if [ -f "$_inference_path" ]; then
    _size=$(wc -c < "$_inference_path" | tr -d ' ')
    log "  Inference model: present ($((_size / 1048576)) MB)"
  else
    log "  Inference model: missing"
    log "  Download ~4.4 GB from: https://tarx.com/models/${INFERENCE_MODEL}"
  fi

  if [ -f "$_embed_path" ]; then
    _size=$(wc -c < "$_embed_path" | tr -d ' ')
    log "  Embedding model: present ($((_size / 1048576)) MB)"
  else
    log "  Embedding model: missing"
    log "  Download ~95 MB from: https://tarx.com/models/${EMBED_MODEL}"
  fi
}

# ── uninstall ────────────────────────────────────────────────────────

cmd_uninstall() {
  log "TARX Uninstaller"
  log ""

  # Stop services first
  cmd_stop 2>/dev/null || true

  # Remove binary
  _bin_path="$(command -v tarx 2>/dev/null || true)"
  if [ -n "$_bin_path" ]; then
    log "Remove binary: ${_bin_path}"
    if [ -w "$(dirname "$_bin_path")" ]; then
      rm -f "$_bin_path"
    else
      sudo rm -f "$_bin_path"
    fi
    log "  Removed."
  fi

  # Ask about data
  log ""
  log "Data directory: ${TARX_DATA}"
  if [ -d "$TARX_DATA" ]; then
    _size=$(du -sh "$TARX_DATA" 2>/dev/null | awk '{print $1}')
    log "Size: ${_size}"
    log ""
    printf 'Delete all TARX data including models? [y/N] '
    read -r _confirm
    case "$_confirm" in
      [yY]|[yY][eE][sS])
        rm -rf "$TARX_DATA"
        log "Data deleted."
        ;;
      *)
        log "Data preserved at ${TARX_DATA}"
        ;;
    esac
  fi

  log ""
  log "TARX uninstalled."
}

# ── route ────────────────────────────────────────────────────────────

run_route_preflight() {
  _route_target="$1"
  _route_endpoint="$2"
  _route_model="$3"
  _route_timeout="${TARX_ROUTE_PREFLIGHT_TIMEOUT_SECONDS:-10}"

  TARX_ROUTE_PREFLIGHT_KEY="${_route_key:-}" \
    python3 - "$_route_target" "$_route_endpoint" "$_route_model" "$_route_timeout" <<'PYEOF'
import json
import os
import socket
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request

target, endpoint, model, timeout_raw = sys.argv[1:]
key = os.environ.get("TARX_ROUTE_PREFLIGHT_KEY", "")


class RouteError(Exception):
    def __init__(self, category, detail, exit_code):
        super().__init__(detail)
        self.category = category
        self.detail = detail
        self.exit_code = exit_code

    def __str__(self):
        return f"Route preflight failed ({self.category}): {self.detail}"


def completion_url(value):
    parsed = urllib.parse.urlsplit(value)
    if parsed.scheme not in {"http", "https"} or not parsed.hostname:
        raise RouteError("endpoint", "endpoint must be an http(s) URL", 3)
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise RouteError(
            "endpoint",
            "endpoint must not contain credentials, query values, or fragments",
            3,
        )
    if target == "remote" and parsed.scheme != "https":
        raise RouteError("policy", "approved remote inference requires HTTPS", 2)
    path = parsed.path.rstrip("/")
    if not path.endswith("/chat/completions"):
        path = f"{path}/chat/completions"
    return urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, path, "", ""))


def display_endpoint(value):
    parsed = urllib.parse.urlsplit(value)
    port = f":{parsed.port}" if parsed.port else ""
    return urllib.parse.urlunsplit(
        (parsed.scheme, f"{parsed.hostname}{port}", parsed.path.rstrip("/"), "", "")
    )


def response_mentions_model(body):
    text = body.decode("utf-8", errors="replace").lower()
    return "model" in text and any(
        marker in text
        for marker in ("not found", "unknown", "unavailable", "does not exist", "access")
    )


try:
    timeout = float(timeout_raw)
except ValueError:
    raise SystemExit(
        "Route preflight failed (configuration): "
        "TARX_ROUTE_PREFLIGHT_TIMEOUT_SECONDS must be numeric"
    )
if timeout <= 0:
    raise SystemExit(
        "Route preflight failed (configuration): timeout must be greater than zero"
    )

payload = json.dumps(
    {
        "model": model,
        "messages": [{"role": "user", "content": "Reply OK."}],
        "max_tokens": 1,
        "stream": False,
    }
).encode("utf-8")
headers = {"Content-Type": "application/json"}
try:
    if key:
        headers["Authorization"] = f"Bearer {key}"
    request = urllib.request.Request(
        completion_url(endpoint),
        data=payload,
        method="POST",
        headers=headers,
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        body = response.read(16384)
    try:
        result = json.loads(body)
    except (TypeError, ValueError):
        raise RouteError(
            "provider-response",
            "provider returned a non-JSON success response",
            6,
        )
    if (
        not isinstance(result, dict)
        or not isinstance(result.get("choices"), list)
        or not result["choices"]
    ):
        raise RouteError(
            "provider-response",
            "provider response did not include a completion choice",
            6,
        )
except urllib.error.HTTPError as error:
    body = error.read(16384)
    if error.code in {401, 403}:
        failure = RouteError(
            "authentication",
            f"provider rejected the credential (HTTP {error.code})",
            4,
        )
    elif error.code in {400, 404} and response_mentions_model(body):
        failure = RouteError(
            "model-access",
            f"configured model is unavailable or unauthorized (HTTP {error.code})",
            5,
        )
    elif error.code == 404:
        failure = RouteError(
            "endpoint",
            "OpenAI-compatible chat completions route was not found (HTTP 404)",
            3,
        )
    elif error.code in {408, 409, 425, 429} or error.code >= 500:
        failure = RouteError(
            "provider-availability",
            f"provider could not serve the preflight request (HTTP {error.code})",
            6,
        )
    else:
        failure = RouteError(
            "provider-response",
            f"provider rejected the preflight request (HTTP {error.code})",
            6,
        )
    print(failure, file=sys.stderr)
    raise SystemExit(failure.exit_code)
except (TimeoutError, socket.timeout):
    print(
        f"Route preflight failed (timeout): provider did not respond within {timeout:g} seconds",
        file=sys.stderr,
    )
    raise SystemExit(7)
except urllib.error.URLError as error:
    if isinstance(error.reason, (TimeoutError, socket.timeout)):
        category = "timeout"
        detail = f"provider did not respond within {timeout:g} seconds"
        exit_code = 7
    else:
        category = "endpoint"
        detail = "provider endpoint is unreachable or its TLS certificate is invalid"
        exit_code = 3
    print(f"Route preflight failed ({category}): {detail}", file=sys.stderr)
    raise SystemExit(exit_code)
except (ssl.SSLError, ConnectionError, OSError):
    print(
        "Route preflight failed (endpoint): "
        "provider endpoint is unreachable or its TLS certificate is invalid",
        file=sys.stderr,
    )
    raise SystemExit(3)
except RouteError as error:
    print(error, file=sys.stderr)
    raise SystemExit(error.exit_code)

print(
    "Route preflight passed: "
    f"target={target} model={model} endpoint={display_endpoint(endpoint)}"
)
PYEOF
}

cmd_route() {
  _route_subcommand="${1:-help}"
  shift 2>/dev/null || true

  case "$_route_subcommand" in
    check)
      _route_target="${1:-local}"
      _route_mode="${2:-}"
      case "$_route_target" in
        local)
          [ -z "$_route_mode" ] || err "Local route check does not accept $_route_mode"
          _route_endpoint="${TARX_LOCAL_INFERENCE_URL:-http://127.0.0.1:${INFERENCE_PORT}/v1}"
          _route_model="${TARX_LOCAL_INFERENCE_MODEL:-local}"
          _route_key="${TARX_LOCAL_INFERENCE_API_KEY:-}"
          ;;
        remote)
          if [ "$_route_mode" = "--offline" ] || [ "${TARX_OFFLINE:-0}" = "1" ]; then
            log "Remote route preflight skipped: offline mode; remote inference remains disabled."
            return 0
          fi
          [ -z "$_route_mode" ] || err "Unknown remote route option: $_route_mode"
          [ "${TARX_ALLOW_REMOTE_INFERENCE:-0}" = "1" ] || \
            err "Remote inference is disabled. Set TARX_ALLOW_REMOTE_INFERENCE=1 to approve this check."
          _route_endpoint="${TARX_REMOTE_INFERENCE_URL:-}"
          _route_model="${TARX_REMOTE_INFERENCE_MODEL:-}"
          _route_key="${TARX_REMOTE_INFERENCE_API_KEY:-}"
          [ -n "$_route_endpoint" ] || err "TARX_REMOTE_INFERENCE_URL is required."
          [ -n "$_route_model" ] || err "TARX_REMOTE_INFERENCE_MODEL is required."
          [ -n "$_route_key" ] || err "TARX_REMOTE_INFERENCE_API_KEY is required."
          ;;
        *)
          err "Unknown route target: $_route_target (available: local, remote)"
          ;;
      esac

      run_route_preflight "$_route_target" "$_route_endpoint" "$_route_model"
      ;;
    help|--help|-h)
      log "Usage: tarx route check [local|remote] [--offline]"
      ;;
    *)
      err "Unknown route command: $_route_subcommand (available: check)"
      ;;
  esac
}

# ── doctor ───────────────────────────────────────────────────────────

cmd_doctor() {
  log "TARX Doctor"
  log "═══════════"
  log ""

  _issues=0

  # Check ports
  log "Services:"
  for _svc_info in "Inference:${INFERENCE_PORT}" "Mesh:${MESH_PORT}" "Embeddings:${EMBED_PORT}" "Cognitive:${COGNITIVE_PORT}"; do
    _name="${_svc_info%%:*}"
    _port="${_svc_info##*:}"
    if check_port "$_port"; then
      printf '  [OK] %-14s port %s\n' "$_name" "$_port"
    else
      # Check if port is taken by something else
      _occupant=$(lsof -ti ":${_port}" 2>/dev/null | head -1) || true
      if [ -n "$_occupant" ]; then
        _proc=$(ps -p "$_occupant" -o comm= 2>/dev/null) || _proc="unknown"
        printf '  [!!] %-14s port %s occupied by %s (pid %s)\n' "$_name" "$_port" "$_proc" "$_occupant"
        _issues=$((_issues + 1))
      else
        printf '  [--] %-14s port %s not running\n' "$_name" "$_port"
      fi
    fi
  done

  # Check disk space
  log ""
  log "Disk:"
  _avail=$(df -h "${HOME}" 2>/dev/null | awk 'NR==2{print $4}')
  log "  Available: ${_avail}"
  # Rough check: need ~6 GB for models
  _avail_bytes=$(df "${HOME}" 2>/dev/null | awk 'NR==2{print $4}')
  if [ -n "$_avail_bytes" ] && [ "$_avail_bytes" -lt 6000000 ] 2>/dev/null; then
    log "  [!!] Less than 6 GB free — models need ~4.5 GB"
    _issues=$((_issues + 1))
  else
    log "  [OK] Sufficient space"
  fi

  # Check models
  log ""
  log "Models:"
  if [ -f "${TARX_MODELS}/${INFERENCE_MODEL}" ]; then
    _sz=$(wc -c < "${TARX_MODELS}/${INFERENCE_MODEL}" | tr -d ' ')
    printf '  [OK] Inference: %s (%s MB)\n' "$INFERENCE_MODEL" "$((_sz / 1048576))"
  else
    printf '  [!!] Inference model missing: %s\n' "${TARX_MODELS}/${INFERENCE_MODEL}"
    _issues=$((_issues + 1))
  fi

  if [ -f "${TARX_MODELS}/${EMBED_MODEL}" ]; then
    _sz=$(wc -c < "${TARX_MODELS}/${EMBED_MODEL}" | tr -d ' ')
    printf '  [OK] Embedding: %s (%s MB)\n' "$EMBED_MODEL" "$((_sz / 1048576))"
  else
    printf '  [!!] Embedding model missing: %s\n' "${TARX_MODELS}/${EMBED_MODEL}"
    _issues=$((_issues + 1))
  fi

  # Check RAM
  log ""
  log "System:"
  if [ "$_os" = "Darwin" ]; then
    _ram_bytes=$(sysctl -n hw.memsize 2>/dev/null) || _ram_bytes=0
    _ram_gb=$((_ram_bytes / 1073741824))
  else
    _ram_kb=$(grep MemTotal /proc/meminfo 2>/dev/null | awk '{print $2}') || _ram_kb=0
    _ram_gb=$((_ram_kb / 1048576))
  fi

  if [ "$_ram_gb" -ge 8 ]; then
    printf '  [OK] RAM: %s GB\n' "$_ram_gb"
  else
    printf '  [!!] RAM: %s GB (need 8 GB+)\n' "$_ram_gb"
    _issues=$((_issues + 1))
  fi

  # GPU detection
  if [ "$_os" = "Darwin" ]; then
    _gpu=$(system_profiler SPDisplaysDataType 2>/dev/null | grep "Chipset Model" | sed 's/.*: //' | head -1) || true
    if [ -z "$_gpu" ]; then
      _gpu=$(sysctl -n machdep.cpu.brand_string 2>/dev/null | head -1) || _gpu="unknown"
    fi
    printf '  [OK] GPU: %s (Metal)\n' "$_gpu"
  else
    if command -v nvidia-smi >/dev/null 2>&1; then
      _gpu=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1) || _gpu="NVIDIA (detected)"
      printf '  [OK] GPU: %s (CUDA)\n' "$_gpu"
    else
      log "  [--] GPU: no NVIDIA GPU detected (CPU inference only)"
    fi
  fi

  # Check for Ollama conflicts
  log ""
  log "Conflicts:"
  if pgrep -x ollama >/dev/null 2>&1; then
    log "  [!!] Ollama is running — may conflict with ports 11434-11437"
    _issues=$((_issues + 1))
  else
    log "  [OK] No Ollama process detected"
  fi

  # llama-server binary
  _llama="$(find_llama_server)" || true
  if [ -n "$_llama" ]; then
    printf '  [OK] llama-server: %s\n' "$_llama"
  else
    log "  [!!] llama-server not found — install with: brew install llama.cpp"
    _issues=$((_issues + 1))
  fi

  log ""
  if [ $_issues -eq 0 ]; then
    log "All checks passed."
  else
    log "${_issues} issue(s) found."
  fi
}

